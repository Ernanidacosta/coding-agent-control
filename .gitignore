# This repository deliberately versions its own deterministic policy and
# clean installation templates, even when a developer's global ignore file
# excludes agent-md artifacts.
!/agent-md.toml
!/.githooks/
!/.githooks/*
!/.agent-md/
!/.agent-md/templates/
!/.agent-md/templates/memory/
!/.agent-md/templates/memory/*.md
# Keep the new installed lifecycle source visible despite global host ignores.
!/.claude/
/.claude/*
!/.claude/hooks/
/.claude/hooks/*
!/.claude/hooks/subagent-lifecycle.sh
