#!/bin/bash
# .githooks/pre-commit
# Universal enforcement layer — works for Codex, Cursor, Windsurf, and
# any agent (or human) that uses git commit.
#
# Activate: git config core.hooksPath .githooks
# Bypass (NOT recommended): git commit --no-verify
#
# Runs the same verification contract as Claude Code's stop-verify hook,
# plus the state-enforcement check against memory/progress.md.
#
# Configuration:
#   agent-md.toml [verify] commands override heuristics. [verify.policy]
#   can declare required checks and a per-check timeout.

set -u

FAIL=0
CHECKS=0

log() { printf '\033[36m▸\033[0m %s\n' "$*"; }
err() { printf '\033[31m✗\033[0m %s\n' "$*" >&2; }
ok()  { printf '\033[32m✓\033[0m %s\n' "$*"; }

policy_message() {
  local severity="$1" code="$2" message="$3" suggestion="$4" result
  if command -v policy_result_json >/dev/null 2>&1; then
    result=$(policy_result_json \
      "$( [ "$severity" = "warning" ] && printf warn || printf fail )" \
      "$severity" "$code" "$message" "$suggestion")
    policy_human_message "$result"
  else
    printf '[%s %s] %s Recovery: %s\n' \
      "$(printf '%s' "$severity" | tr '[:lower:]' '[:upper:]')" \
      "$code" "$message" "$suggestion"
  fi
}

log "agent-md pre-commit verification"

# --- Shared helpers ---
# Prefer the host-neutral library so Stop + pre-commit stay in lockstep.
if [ -f ".claude/hooks/_lib.sh" ]; then
  # shellcheck source=.claude/hooks/_lib.sh
  . ".claude/hooks/_lib.sh"
  SHARED_STATE_AVAILABLE=1
else
  SHARED_STATE_AVAILABLE=0
fi

if [ "$SHARED_STATE_AVAILABLE" -eq 1 ]; then
  completion_evaluation_begin
  COMPLETION_CONTEXT=$(completion_evaluation_context_json staged standalone)
  log "completion budget: $(printf '%s' "$COMPLETION_CONTEXT" | jq -r '.budget.seconds // "unbounded"') ($(printf '%s' "$COMPLETION_CONTEXT" | jq -r '.budget.source'))"
  COMPLETION_EVALUATION=$(run_completion_evaluation "$COMPLETION_CONTEXT" advisory)
  BASE_VERIFY_SUMMARY=$(printf '%s' "$COMPLETION_EVALUATION" | jq -c '.verification')
  VERIFY_SUMMARY=$(printf '%s' "$COMPLETION_EVALUATION" | jq -c '.summary')
  VERIFY_STATUS=$(printf '%s' "$VERIFY_SUMMARY" | jq -r '.status')
  CHECKS=$(printf '%s' "$BASE_VERIFY_SUMMARY" | jq '[.results[] | select(.check != "contract")] | length')
  while IFS= read -r VERIFY_RESULT; do
    [ -n "$VERIFY_RESULT" ] || continue
    RESULT_STATUS=$(printf '%s' "$VERIFY_RESULT" | jq -r '.status')
    RESULT_CHECK=$(printf '%s' "$VERIFY_RESULT" | jq -r '.check // "verification"')
    if [ "$RESULT_STATUS" = pass ]; then
      ok "$RESULT_CHECK"
    elif [ "$RESULT_STATUS" = warn ]; then
      log "$(verification_result_human "$VERIFY_RESULT")"
    else
      err "$(verification_result_human "$VERIFY_RESULT")"
    fi
  done < <(printf '%s' "$VERIFY_SUMMARY" | jq -c '.results[]')
  [ "$VERIFY_STATUS" != fail ] || FAIL=1
fi

# --- Operational state enforcement ---
# Uses the exact same classifier as Claude/Codex Stop. New installs always
# include _lib.sh; the fallback warning only covers manually copied legacy
# pre-commit hooks.
if [ "$SHARED_STATE_AVAILABLE" -eq 1 ]; then
  STATE_RESULT=$(state_enforcement_result staged)
  if [ -n "$STATE_RESULT" ]; then
    STATE_STATUS=$(printf '%s' "$STATE_RESULT" | jq -r '.status')
    STATE_MESSAGE=$(policy_human_message "$STATE_RESULT")
    if [ "$STATE_STATUS" = "fail" ]; then
      err "$STATE_MESSAGE"
      FAIL=1
    else
      log "$STATE_MESSAGE"
    fi
  else
    ok "operational state up to date"
  fi
else
  err "$(policy_message \
    error CONFIG_INVALID \
    "The shared state classifier is unavailable, so the state-integrity guarantee could not run." \
    "Reinstall agent-md before committing.")"
  FAIL=1
fi

echo ""
if [ "$FAIL" -eq 1 ]; then
  err "Pre-commit BLOCKED. Fix errors above, re-stage, and retry."
  echo "   (Bypass not recommended: git commit --no-verify)"
  exit 1
fi

if [ "$CHECKS" -eq 0 ] && [ "$SHARED_STATE_AVAILABLE" -eq 0 ]; then
  err "$(policy_message \
    error CONFIG_INVALID \
    "The shared verification contract is unavailable." \
    "Reinstall agent-md before committing.")"
else
  if [ "$FAIL" -eq 0 ] && [ "$CHECKS" -gt 0 ]; then
    ok "All required checks passed; $CHECKS configured or inferred check(s) evaluated."
  fi
fi
exit 0
