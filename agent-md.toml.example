# agent-md.toml — explicit configuration for coding-agent-control hooks.
#
# The filename is retained as a compatibility interface from the project's
# historical agent-md lineage.
#
# This file is optional. Copy it to the repo root as `agent-md.toml` only when
# you want explicit verification, operational-change detection, or optional
# integrations. Basic coding-agent-control safety and operational state need no config.
# Anything you leave unset falls back to the heuristic default.
#
# Verification values must be trusted project commands as simple strings
# on a single line. Required checks and state globs are arrays of quoted
# strings and may span multiple lines.

[verify]
# Project-wide type-check command. Runs at Stop and at pre-commit.
# typecheck = "npx --no-install tsc --noEmit"

# Project-wide lint command. Runs at Stop and at pre-commit.
# lint = "npx --no-install eslint ."

# Per-file lint used by post-edit-verify (fast, runs after every Write/Edit).
# The string {file} is substituted with the edited file path.
# lint_file = "npx --no-install eslint {file}"

# Test suite. Runs at Stop and at pre-commit.
# When unset, both hooks detect the package manager via lockfile
# (pnpm > yarn > bun > npm) and run the detected `<pm> test`. Because
# both hooks share the same detector in .claude/hooks/_lib.sh, they
# cannot disagree.
# test = "pnpm test --silent"

# Integration, smoke, and runtime checks are distinct evidence. Declare only
# the paths this project can execute deterministically; one category does not
# substitute for another.
# integration = "docker compose run --rm app integration-test"
# smoke = "./scripts/smoke.sh"
# runtime = "./bin/my-cli --version"

# Conditional attestation verifiers. They are not ordinary optional checks:
# Risk high/critical requires `independent`; Risk critical also requires
# `approval`. Each value must be one direct executable path already present
# unchanged in the committed HEAD version of agent-md.toml. Exit 0 is necessary
# but not sufficient: stdout must be exactly one structured attestation JSON
# object bound to the full current HEAD commit. See README.md.
# independent = "./scripts/verify-ci-attestation.sh"
# approval = "./scripts/verify-human-approval.sh"

[verify.policy]
# When omitted, configured/inferred checks retain the legacy required
# behavior. When present, listed checks are required and other configured or
# inferred checks are optional. Allowed names: typecheck, lint, test,
# integration, smoke, runtime. Independent/approval are conditional on Risk
# and do not belong in this array.
# required = ["lint", "test", "smoke"]

# Optional per-check timeout. A required timeout blocks; an optional timeout
# warns. Requires `timeout` (or `gtimeout`) on PATH.
# timeout_seconds = 300

# Optional core deadline for the complete completion evaluation: policy/control
# resolution, ordinary checks, Risk, applicable independent/approval providers,
# and the structured decision. Host hook timeouts are larger transport envelopes
# materialized by the installer; rerun it after changing this value.
# total_timeout_seconds = 420

[verify.attestation]
# Explicit repo-local dependency sets for each repo-local verifier. The key is
# required when that verifier is repo-local; use [] to assert that it has no
# repo-local dependencies beyond its implicitly checked executable. List every
# additional repo-local file that participates in producing or validating the
# attestation. Arrays and files must already exist unchanged in HEAD. coding-agent-control
# deliberately does not infer shell imports.
# independent_files = []
# approval_files = ["scripts/attestation-lib.sh"]

# Optional external command capabilities used by an attestation verifier.
# These are generic command names for doctor/verify diagnostics, not providers
# or commands for the core to execute. A missing capability warns during
# active/verifying work and blocks a final Risk guarantee that requires the
# corresponding attestation. Capability declarations must also match HEAD.
# independent_capabilities = ["gh"]
# approval_capabilities = ["company-approval-cli"]

[visual]
# When true, sensory-reminder.sh becomes a BLOCKING hook.
#
# It is NOT enough to drop a screenshot into artifacts_dir. The hook
# requires STRUCTURED evidence:
#
#   1. A non-empty markdown file under artifacts_dir modified within
#      freshness_seconds.
#   2. A non-empty image (.png/.jpg/.jpeg/.webp/.gif) under artifacts_dir,
#      also modified within freshness_seconds.
#   3. The markdown file must reference the image by filename
#      (literal substring match, e.g. `home-after.png`).
#   4. The markdown must include these field labels: Changed files,
#      Route or URL, Viewport, Artifact, Observed result.
#
# Recommended contents for the markdown note:
#   - changed files (paths)
#   - route / URL captured
#   - viewport (e.g. 1440x900)
#   - artifact path (the image filename)
#   - observed result — what you verified, in prose
#
# A screenshot alone is not verification. The prose is the claim.
# required = false

# Where visual evidence artifacts live.
# artifacts_dir = ".agent/visual"

# Max age of an artifact (seconds) before it's considered stale.
# Applies to both the markdown note and the image it references.
# freshness_seconds = 3600

[state]
# Operationally relevant paths. If omitted, coding-agent-control uses broad defaults
# for common source/test directories and executable code extensions.
# Declaring this key replaces the default source list.
# source_globs = [
#   "src/**",
#   "app/**",
#   "tests/**",
#   "*.py",
# ]

# Paths that never require a progress update. Ignore wins over source.
# Declaring this key replaces the default ignore list. scripts/** and
# tools/** are intentionally NOT ignored by default because they often
# contain executable product code.
# ignore_globs = [
#   "docs/**",
#   ".ai-memory.toml",
#   ".gitignore",
# ]

[integrations.icm]
# Enables the ICM reference integration for optional semantic/historical
# recall. ICM is one provider, not an architectural dependency. Leaving this
# section undeclared creates no expectation; hooks, verification, Risk, trust,
# and completion never depend on semantic-memory availability.
# enabled = false
