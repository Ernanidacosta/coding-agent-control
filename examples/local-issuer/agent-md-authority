#!/bin/bash
# agent-md-authority — enrollment authority for verification receipts.
#
# This is the component that decides which projects may ever receive an
# authenticated verification receipt, and exactly what a future issuer would be
# allowed to execute on their behalf. It is deliberately separate from the
# repository it approves: a repository can ask for capability, it can never
# grant capability to itself.
#
# C1 implements install, enroll and show. Issuing receipts, running checks,
# signing and sequence allocation are later slices and are absent here on
# purpose.
#
# Hostile-input rule: a workspace is untrusted content. This program never
# sources, imports or executes anything from it, and never runs git inside it.
# It only resolves paths, stats them, reads files as data, and hashes them. The
# TOML reader below is authority-owned for that reason: the repository's own
# parser lives in the repository.

set -u

AUTHORITY_SCHEMA=1
DEFAULT_EXEC_PATH=/usr/local/bin:/usr/bin:/bin
MECHANISM_FILES=".claude/hooks/_lib.sh .claude/hooks/stop-verify.sh .agent-md/bin/verify.sh"

PROGRAM=${0##*/}

die() { printf '%s: %s\n' "$PROGRAM" "$1" >&2; exit "${2:-1}"; }
note() { printf '%s\n' "$1"; }

usage() {
  cat <<'USAGE'
Usage:
  agent-md-authority install [--root PREFIX] [--user NAME] [--dry-run]
  agent-md-authority enroll  WORKSPACE [--root PREFIX] [--exec-user NAME]
                             [--exec-path VALUE] [--env NAME=VALUE]...
                             [--yes] [--dry-run]
  agent-md-authority show    (PROJECT_ID | --workspace PATH) [--root PREFIX]

Options:
  --root PREFIX   Operate under an alternate filesystem root. Intended for
                  tests and staging; the real installation uses /.
  --yes           Accept the presented enrollment without prompting. This is an
                  explicit flag on purpose; no environment variable enables it.
USAGE
}

# --- Paths -------------------------------------------------------------------
# ROOT is a prefix, not a chroot. With the default prefix the layout is the
# documented /usr/local/lib and /var/lib one.
ROOT=""

lib_dir()      { printf '%s/usr/local/lib/agent-md' "$ROOT"; }
state_dir()    { printf '%s/var/lib/agent-md' "$ROOT"; }
projects_dir() { printf '%s/projects' "$(state_dir)"; }
keys_dir()     { printf '%s/keys' "$(state_dir)"; }

is_real_root_prefix() { [ -z "$ROOT" ]; }

# --- Filesystem safety -------------------------------------------------------

# A privileged path must never traverse a symlink: the developer could point a
# component somewhere else between checks and writes.
path_has_symlink() {
  local p="$1"
  while [ -n "$p" ] && [ "$p" != "/" ] && [ "$p" != "." ]; do
    if [ -L "$p" ]; then return 0; fi
    p=$(dirname "$p")
  done
  return 1
}

mode_of() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null; }
owner_of() { stat -c %u "$1" 2>/dev/null || stat -f %u "$1" 2>/dev/null; }
group_of() { stat -c %g "$1" 2>/dev/null || stat -f %g "$1" 2>/dev/null; }

digit_has_write() { case "$1" in 2|3|6|7) return 0 ;; esac; return 1; }

world_writable() {
  local mode
  mode=$(mode_of "$1") || return 1
  digit_has_write "${mode: -1}"
}

# Refuses a privileged directory that is already unsafe when we find it.
assert_safe_dir() {
  local dir="$1"
  [ -e "$dir" ] || return 0
  if path_has_symlink "$dir"; then
    die "refusing to use '$dir': a path component is a symlink"
  fi
  if [ ! -d "$dir" ]; then
    die "refusing to use '$dir': it exists and is not a directory"
  fi
  if world_writable "$dir"; then
    die "refusing to use '$dir': it is world-writable"
  fi
}

# Writes stdin to a file through a temporary in the same directory, so a reader
# never observes a partial record.
atomic_write() {
  local target="$1" mode="$2" dir tmp
  dir=$(dirname "$target")
  tmp=$(mktemp "$dir/.agent-md-authority.XXXXXX") || die "cannot create temporary file in $dir"
  cat > "$tmp" || { rm -f "$tmp"; die "cannot write $target"; }
  chmod "$mode" "$tmp" || { rm -f "$tmp"; die "cannot set mode on $target"; }
  mv -f "$tmp" "$target" || { rm -f "$tmp"; die "cannot replace $target"; }
}

sha256_file() {
  local out
  if command -v sha256sum >/dev/null 2>&1; then
    out=$(sha256sum < "$1") || return 1
    printf '%s' "${out%% *}"
  elif command -v shasum >/dev/null 2>&1; then
    out=$(shasum -a 256 < "$1") || return 1
    printf '%s' "${out%% *}"
  elif command -v openssl >/dev/null 2>&1; then
    out=$(openssl dgst -sha256 < "$1") || return 1
    printf '%s' "${out##* }"
  else
    return 127
  fi
}

new_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  elif command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 16
  else
    die "no source of unique identifiers is available"
  fi
}

# --- TOML, authority-owned ---------------------------------------------------
# Deliberately minimal and deliberately not the repository's parser. It reads
# values; it never evaluates them.

toml_scalar() {
  local file="$1" section="$2" key="$3"
  awk -v section="$section" -v key="$key" '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    /^[ \t]*\[/ {
      line = trim($0); sub(/^\[/, "", line); sub(/\].*$/, "", line)
      current = line; next
    }
    current == section {
      line = $0
      pos = index(line, "=")
      if (pos == 0) next
      name = trim(substr(line, 1, pos - 1))
      if (name != key) next
      value = trim(substr(line, pos + 1))
      if (value ~ /^".*"$/) { value = substr(value, 2, length(value) - 2) }
      else if (value ~ /^'"'"'.*'"'"'$/) { value = substr(value, 2, length(value) - 2) }
      print value; exit
    }
  ' "$file"
}

toml_array() {
  local file="$1" section="$2" key="$3"
  awk -v section="$section" -v key="$key" '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    /^[ \t]*\[[A-Za-z]/ {
      line = trim($0); sub(/^\[/, "", line); sub(/\].*$/, "", line)
      current = line; collecting = 0; next
    }
    {
      if (collecting) { buffer = buffer $0; if (index($0, "]")) { collecting = 0; emit = 1 } }
      else if (current == section) {
        pos = index($0, "=")
        if (pos > 0 && trim(substr($0, 1, pos - 1)) == key) {
          buffer = substr($0, pos + 1)
          if (index(buffer, "]")) { emit = 1 } else { collecting = 1 }
        }
      }
      if (emit) {
        sub(/^[^[]*\[/, "", buffer); sub(/\].*$/, "", buffer)
        n = split(buffer, items, ",")
        for (i = 1; i <= n; i++) {
          v = trim(items[i])
          if (v ~ /^".*"$/) { v = substr(v, 2, length(v) - 2) }
          if (v != "") print v
        }
        exit
      }
    }
  ' "$file"
}

# --- Identity of the execution user -----------------------------------------

passwd_field() {
  local user="$1" field="$2" line
  line=$(getent passwd "$user" 2>/dev/null) || return 1
  printf '%s' "$line" | cut -d: -f"$field"
}

uid_of_user() { passwd_field "$1" 3; }
home_of_user() { passwd_field "$1" 6; }
gids_of_user() { id -G "$1" 2>/dev/null; }

# --- PATH eligibility --------------------------------------------------------
# A PATH entry the execution user can write is a way to replace a real tool with
# one that exits 0, collect an authenticated PASS and put the real tool back.
# The source fingerprint would not notice, because the directory is outside the
# repository. For the first provider this is disqualifying, not advisory.

dir_writable_by_user() {
  local dir="$1" uid="$2" gids="$3" owner group mode ugo gid
  owner=$(owner_of "$dir") || return 2
  group=$(group_of "$dir") || return 2
  mode=$(mode_of "$dir") || return 2
  ugo=${mode: -3}
  if digit_has_write "${ugo:2:1}"; then return 0; fi
  if [ "$owner" = "$uid" ] && digit_has_write "${ugo:0:1}"; then return 0; fi
  if digit_has_write "${ugo:1:1}"; then
    for gid in $gids; do
      [ "$gid" = "$group" ] && return 0
    done
  fi
  return 1
}

# Emits one JSON object per PATH entry describing why it is or is not eligible.
path_entry_report() {
  local entry="$1" uid="$2" gids="$3" resolved parent status reason
  status=eligible; reason=""
  if [ -z "$entry" ]; then
    printf '{"entry":"","resolved":null,"status":"ineligible","reason":"empty PATH entry means the current directory"}'
    return
  fi
  case "$entry" in
    /*) ;;
    *)
      printf '{"entry":%s,"resolved":null,"status":"ineligible","reason":"relative PATH entry"}' "$(json_string "$entry")"
      return
      ;;
  esac
  resolved=$(realpath "$entry" 2>/dev/null) || {
    printf '{"entry":%s,"resolved":null,"status":"ineligible","reason":"PATH entry does not resolve"}' "$(json_string "$entry")"
    return
  }
  if [ ! -d "$resolved" ]; then
    printf '{"entry":%s,"resolved":%s,"status":"ineligible","reason":"PATH entry is not a directory"}' \
      "$(json_string "$entry")" "$(json_string "$resolved")"
    return
  fi
  if dir_writable_by_user "$resolved" "$uid" "$gids"; then
    status=ineligible; reason="writable by the execution user"
  else
    parent=$(dirname "$resolved")
    if dir_writable_by_user "$parent" "$uid" "$gids"; then
      status=ineligible; reason="parent directory is writable by the execution user"
    fi
  fi
  printf '{"entry":%s,"resolved":%s,"status":%s,"reason":%s}' \
    "$(json_string "$entry")" "$(json_string "$resolved")" \
    "$(json_string "$status")" "$(json_string "$reason")"
}

# --- Environment allowlist ---------------------------------------------------
# The execution environment is approved policy, not a snapshot of whatever the
# caller happened to export. Nothing that looks like credential material is ever
# captured, because enrollment records are world-readable.

env_name_is_forbidden() {
  case "$1" in
    *TOKEN*|*SECRET*|*PASSWORD*|*PASSWD*|*CREDENTIAL*|*PRIVATE*|*SESSION*) return 0 ;;
    *_KEY|*_KEYS|KEY|APIKEY|*APIKEY*|*ACCESS_KEY*) return 0 ;;
    AWS_*|GITHUB_*|GH_*|OPENAI_*|ANTHROPIC_*|GOOGLE_*|AZURE_*|NPM_*|PYPI_*) return 0 ;;
    SSH_AUTH_SOCK|DOCKER_HOST|SSH_AGENT_PID) return 0 ;;
    LD_PRELOAD|LD_LIBRARY_PATH|BASH_ENV|ENV|PYTHONPATH|PYTHONHOME|PERL5LIB|NODE_OPTIONS) return 0 ;;
  esac
  return 1
}

json_string() {
  printf '%s' "$1" | jq -Rs .
}

# --- install -----------------------------------------------------------------

cmd_install() {
  local user=agentmd dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --user) user="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown install option: $1" ;;
    esac
  done

  if is_real_root_prefix && [ "$(id -u)" != 0 ]; then
    die "install must run as root; re-run with sudo, or pass --root PREFIX for a staging tree"
  fi

  local lib state projects keys
  lib=$(lib_dir); state=$(state_dir); projects=$(projects_dir); keys=$(keys_dir)
  assert_safe_dir "$lib"; assert_safe_dir "$state"
  assert_safe_dir "$projects"; assert_safe_dir "$keys"

  if [ "$dry_run" -eq 1 ]; then
    note "would ensure service account: $user"
    note "would create $lib (root, 0755)"
    note "would create $state (root, 0755)"
    note "would create $projects ($user, 0755)"
    note "would create $keys ($user, 0700)"
    note "would install $lib/agent-md-authority (root, 0755)"
    return 0
  fi

  if is_real_root_prefix; then
    if ! getent passwd "$user" >/dev/null 2>&1; then
      useradd --system --home-dir "$state" --shell /usr/sbin/nologin "$user" \
        || die "cannot create service account $user"
      note "created service account $user"
    else
      note "service account $user already present"
    fi
  else
    note "staging root in use; service account $user is not created"
  fi

  mkdir -p "$lib" "$state" "$projects" "$keys" || die "cannot create authority directories"
  chmod 0755 "$lib" "$state" "$projects" || die "cannot set directory modes"
  chmod 0700 "$keys" || die "cannot set key directory mode"
  if is_real_root_prefix; then
    chown root:root "$lib" "$state" || die "cannot set ownership"
    chown "$user":"$user" "$projects" "$keys" || die "cannot set ownership"
  fi

  local self target
  self=$(realpath "$0") || die "cannot resolve own path"
  target="$lib/agent-md-authority"
  if [ -e "$target" ] && cmp -s "$self" "$target"; then
    note "authority program already current"
  else
    atomic_write "$target" 0755 < "$self"
    is_real_root_prefix && chown root:root "$target"
    note "installed $target"
  fi

  printf '%s\n' "$AUTHORITY_SCHEMA" | atomic_write "$state/schema" 0644
  note "authority ready under $state"
}

# --- enroll ------------------------------------------------------------------

cmd_enroll() {
  local workspace="" exec_user="" exec_path="" assume_yes=0 dry_run=0
  local extra_env=() name value
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --exec-user) exec_user="$2"; shift 2 ;;
      --exec-path) exec_path="$2"; shift 2 ;;
      --env) extra_env+=("$2"); shift 2 ;;
      --yes) assume_yes=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown enroll option: $1" ;;
      *) [ -z "$workspace" ] || die "only one workspace may be enrolled at a time"; workspace="$1"; shift ;;
    esac
  done
  [ -n "$workspace" ] || die "enroll requires a workspace path"
  [ -n "$exec_user" ] || exec_user=${SUDO_USER:-$(id -un)}
  [ -n "$exec_path" ] || exec_path="$DEFAULT_EXEC_PATH"

  local projects; projects=$(projects_dir)
  [ -d "$projects" ] || die "authority is not installed under $(state_dir); run install first"
  assert_safe_dir "$projects"

  # The workspace is hostile content. Resolve it ourselves and only ever read it.
  local canonical; canonical=$(realpath "$workspace" 2>/dev/null) \
    || die "workspace does not resolve: $workspace"
  [ -d "$canonical" ] || die "workspace is not a directory: $canonical"
  [ -e "$canonical/.git" ] || die "workspace is not a Git repository: $canonical"

  local existing; existing=$(find_project_by_workspace "$canonical")
  [ -z "$existing" ] || die "workspace is already enrolled as $existing; revoke it before enrolling again"

  local uid home gids
  uid=$(uid_of_user "$exec_user") || die "unknown execution user: $exec_user"
  home=$(home_of_user "$exec_user") || die "cannot resolve home for $exec_user"
  gids=$(gids_of_user "$exec_user") || die "cannot resolve groups for $exec_user"

  # --- contract, read strictly as data ---
  local config="$canonical/agent-md.toml"
  [ -f "$config" ] || die "no agent-md.toml in $canonical"
  local contract; contract=$(read_contract "$config") || die "agent-md.toml could not be read as a verification contract"
  local contract_fp; contract_fp=$(printf '%s' "$contract" | jq -cS . | sha256_hex) \
    || die "cannot fingerprint the contract"

  # --- mechanism identities ---
  local mechanism; mechanism=$(read_mechanism "$canonical") \
    || die "mechanism files are missing or unreadable in $canonical"

  # --- environment allowlist ---
  local environment; environment=$(build_environment "$home" "$exec_path" "${extra_env[@]+"${extra_env[@]}"}") || exit 1

  # --- PATH eligibility ---
  local path_report; path_report=$(build_path_report "$exec_path" "$uid" "$gids")
  local path_ok; path_ok=$(printf '%s' "$path_report" | jq 'all(.[]; .status == "eligible")')

  local status reasons
  reasons='[]'
  status=eligible
  if [ "$path_ok" != true ]; then
    status=ineligible
    reasons=$(printf '%s' "$path_report" | jq -c '[.[] | select(.status != "eligible")
      | "PATH entry \(.entry): \(.reason)"]')
  fi

  local project_id; project_id=$(new_uuid)
  local record
  record=$(jq -n \
    --argjson schema "$AUTHORITY_SCHEMA" \
    --arg project_id "$project_id" \
    --arg workspace "$canonical" \
    --arg exec_user "$exec_user" \
    --argjson exec_uid "$uid" \
    --argjson contract "$contract" \
    --arg contract_fingerprint "$contract_fp" \
    --argjson mechanism "$mechanism" \
    --argjson environment "$environment" \
    --argjson path_eligibility "$path_report" \
    --arg status "$status" \
    --argjson reasons "$reasons" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{
      schema: $schema,
      project_id: $project_id,
      workspace: $workspace,
      execution: {user: $exec_user, uid: $exec_uid},
      approved_contract: $contract,
      approved_contract_fingerprint: $contract_fingerprint,
      approved_mechanism: $mechanism,
      approved_environment: $environment,
      path_eligibility: $path_eligibility,
      status: $status,
      reasons: $reasons,
      metadata: {created: $created, note: "timestamps are descriptive and are never used for ordering or authority"}
    }')

  present_enrollment "$record"

  if [ "$dry_run" -eq 1 ]; then
    note ""
    note "dry run: nothing was written."
    return 0
  fi
  if [ "$assume_yes" -ne 1 ]; then
    printf '\nApprove this enrollment? [y/N] '
    local answer; read -r answer
    case "$answer" in y|Y|yes|YES) ;; *) die "enrollment declined; nothing was written" ;; esac
  fi

  local dir="$projects/$project_id"
  mkdir -p "$dir" || die "cannot create $dir"
  chmod 0755 "$dir"
  printf '%s\n' "$record" | atomic_write "$dir/enrollment.json" 0644
  jq -nc --argjson schema "$AUTHORITY_SCHEMA" \
    '{schema: $schema, last_terminal: null, pending: null}' \
    | atomic_write "$dir/state.json" 0644
  note ""
  note "enrolled $canonical as $project_id ($status)"
}

sha256_hex() {
  local tmp out
  tmp=$(mktemp) || return 1
  cat > "$tmp"
  out=$(sha256_file "$tmp"); rm -f "$tmp"
  printf '%s' "$out"
}

read_contract() {
  local config="$1" check command required timeout total
  local checks='[]'
  for check in typecheck lint test integration smoke runtime; do
    command=$(toml_scalar "$config" verify "$check")
    [ -n "$command" ] || continue
    checks=$(printf '%s' "$checks" | jq -c --arg name "$check" --arg command "$command" \
      '. + [{name: $name, command: $command}]')
  done
  required=$(toml_array "$config" verify.policy required | jq -Rsc 'split("\n") | map(select(length > 0))')
  timeout=$(toml_scalar "$config" verify.policy timeout_seconds)
  total=$(toml_scalar "$config" verify.policy total_timeout_seconds)
  if [ "$(printf '%s' "$checks" | jq 'length')" -eq 0 ]; then
    return 1
  fi
  jq -nc --argjson checks "$checks" --argjson required "$required" \
    --arg timeout "$timeout" --arg total "$total" \
    '{
      checks: $checks,
      required: $required,
      timeout_seconds: (if $timeout == "" then null else ($timeout | tonumber? // null) end),
      total_timeout_seconds: (if $total == "" then null else ($total | tonumber? // null) end)
    }'
}

read_mechanism() {
  local workspace="$1" file digest entries='[]'
  for file in $MECHANISM_FILES; do
    [ -f "$workspace/$file" ] || return 1
    [ -L "$workspace/$file" ] && return 1
    digest=$(sha256_file "$workspace/$file") || return 1
    entries=$(printf '%s' "$entries" | jq -c --arg path "$file" --arg digest "$digest" \
      '. + [{path: $path, algorithm: "sha256", digest: $digest}]')
  done
  printf '%s' "$entries"
}

build_environment() {
  local home="$1" path="$2"; shift 2
  local pair name value entries
  entries=$(jq -nc --arg home "$home" --arg path "$path" \
    '[{name: "HOME", value: $home}, {name: "PATH", value: $path}]')
  for name in LANG LC_ALL LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MESSAGES; do
    value=$(printenv "$name" 2>/dev/null) || continue
    [ -n "$value" ] || continue
    entries=$(printf '%s' "$entries" | jq -c --arg name "$name" --arg value "$value" \
      '. + [{name: $name, value: $value}]')
  done
  for pair in "$@"; do
    case "$pair" in
      *=*) ;;
      *) die "--env expects NAME=VALUE, got: $pair" ;;
    esac
    name=${pair%%=*}; value=${pair#*=}
    if env_name_is_forbidden "$name"; then
      die "refusing to record '$name' in a world-readable enrollment; credential-like and loader variables are never captured"
    fi
    entries=$(printf '%s' "$entries" | jq -c --arg name "$name" --arg value "$value" \
      '. + [{name: $name, value: $value}]')
  done
  printf '%s' "$entries" | jq -cS 'sort_by(.name)'
}

build_path_report() {
  local path="$1" uid="$2" gids="$3" entry report='[]'
  local saved_ifs="$IFS"
  IFS=:
  for entry in $path; do
    IFS="$saved_ifs"
    report=$(printf '%s' "$report" | jq -c --argjson item "$(path_entry_report "$entry" "$uid" "$gids")" '. + [$item]')
    IFS=:
  done
  IFS="$saved_ifs"
  printf '%s' "$report"
}

find_project_by_workspace() {
  local canonical="$1" dir record
  local projects; projects=$(projects_dir)
  [ -d "$projects" ] || return 0
  for dir in "$projects"/*/; do
    [ -f "$dir/enrollment.json" ] || continue
    record=$(jq -r '.workspace // empty' "$dir/enrollment.json" 2>/dev/null) || continue
    if [ "$record" = "$canonical" ]; then
      jq -r '.project_id' "$dir/enrollment.json"
      return 0
    fi
  done
  return 0
}

present_enrollment() {
  local record="$1"
  note "Enrollment for review"
  note "---------------------"
  note "workspace:      $(printf '%s' "$record" | jq -r '.workspace')"
  note "execution user: $(printf '%s' "$record" | jq -r '.execution.user') (uid $(printf '%s' "$record" | jq -r '.execution.uid'))"
  note ""
  note "commands the issuer would be allowed to run:"
  printf '%s' "$record" | jq -r '.approved_contract.checks[] | "  \(.name): \(.command)"'
  note ""
  note "required checks: $(printf '%s' "$record" | jq -r '.approved_contract.required | join(", ")')"
  note "contract fingerprint: $(printf '%s' "$record" | jq -r '.approved_contract_fingerprint')"
  note ""
  note "mechanism identities:"
  printf '%s' "$record" | jq -r '.approved_mechanism[] | "  \(.path)  \(.digest)"'
  note ""
  note "execution environment:"
  printf '%s' "$record" | jq -r '.approved_environment[] | "  \(.name)=\(.value)"'
  note ""
  note "PATH eligibility:"
  printf '%s' "$record" | jq -r '.path_eligibility[] | "  [\(.status)] \(.entry)\(if .reason == "" then "" else " — \(.reason)" end)"'
  note ""
  note "status: $(printf '%s' "$record" | jq -r '.status')"
  printf '%s' "$record" | jq -r '.reasons[]? | "  reason: \(.)"'
}

# --- show --------------------------------------------------------------------

cmd_show() {
  local project_id="" workspace=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --workspace) workspace="$2"; shift 2 ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown show option: $1" ;;
      *) project_id="$1"; shift ;;
    esac
  done
  if [ -n "$workspace" ]; then
    local canonical; canonical=$(realpath "$workspace" 2>/dev/null) || die "workspace does not resolve"
    project_id=$(find_project_by_workspace "$canonical")
    [ -n "$project_id" ] || die "no enrollment for $canonical"
  fi
  [ -n "$project_id" ] || die "show requires a project id or --workspace"
  case "$project_id" in */*|..|.) die "invalid project id" ;; esac

  local file
  file="$(projects_dir)/$project_id/enrollment.json"
  [ -f "$file" ] || die "no enrollment for $project_id"
  if path_has_symlink "$file"; then die "refusing to read $file: a path component is a symlink"; fi

  local record; record=$(cat "$file")
  note "project id:     $(printf '%s' "$record" | jq -r '.project_id')"
  present_enrollment "$record"
}

# --- dispatch ----------------------------------------------------------------

[ $# -gt 0 ] || { usage; exit 1; }
command -v jq >/dev/null 2>&1 || die "jq is required"
subcommand="$1"; shift
case "$subcommand" in
  install) cmd_install "$@" ;;
  enroll) cmd_enroll "$@" ;;
  show) cmd_show "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown subcommand: $subcommand" ;;
esac
