#!/bin/bash
# agent-md-authority — enrollment authority for verification receipts.
#
# Decides which projects may ever receive an authenticated verification
# receipt, and records exactly what a future issuer would be allowed to run on
# their behalf. A repository can request capability; it can never grant
# capability to itself.
#
# install, enroll and show only. Issuing receipts, executing checks, signing
# and sequence allocation live in later slices and are absent here on purpose.

# PROGRAM and ROOT are consumed by authority-lib.sh. shellcheck only follows a
# sourced file when invoked with -x, so these directives keep the program
# clean under either invocation.
# shellcheck disable=SC2034
set -u
PROGRAM=${0##*/}

AUTHORITY_SELF_DIR=$(cd "$(dirname "$(realpath "$0")")" && pwd)
# shellcheck source=examples/local-issuer/authority-lib.sh
# shellcheck disable=SC1091
. "$AUTHORITY_SELF_DIR/authority-lib.sh"

usage() {
  cat <<'USAGE'
Usage:
  agent-md-authority install [--root PREFIX] [--user NAME] [--dry-run]
  agent-md-authority enroll  WORKSPACE [--root PREFIX] [--exec-user NAME]
                             [--exec-path VALUE] [--env NAME=VALUE]...
                             [--yes] [--dry-run]
  agent-md-authority show    (PROJECT_ID | --workspace PATH) [--root PREFIX]

Options:
  --root PREFIX   Operate under an alternate filesystem root. Intended for
                  tests and staging; the real installation uses /.
  --yes           Accept the presented enrollment without prompting. This is a
                  command-line flag on purpose; no environment variable
                  approves an enrollment.
USAGE
}

new_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  elif command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 16
  else
    die "no source of unique identifiers is available"
  fi
}

AUTHORITY_INSTALLED_FILES="authority-lib.sh agent-md-authority agent-md-issuer"

cmd_install() {
  local user=agentmd dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --user) user="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown install option: $1" ;;
    esac
  done

  if is_real_root_prefix && [ "$(id -u)" != 0 ]; then
    die "install must run as root; re-run with sudo, or pass --root PREFIX for a staging tree"
  fi

  local lib state projects keys
  lib=$(lib_dir); state=$(state_dir); projects=$(projects_dir); keys=$(keys_dir)
  assert_safe_dir "$lib"; assert_safe_dir "$state"
  assert_safe_dir "$projects"; assert_safe_dir "$keys"

  local name
  if [ "$dry_run" -eq 1 ]; then
    note "would ensure service account: $user"
    note "would create $lib (root, 0755)"
    note "would create $state (root, 0755)"
    note "would create $projects ($user, 0755)"
    note "would create $keys ($user, 0700)"
    for name in $AUTHORITY_INSTALLED_FILES; do
      note "would install $lib/$name (root, 0755)"
    done
    return 0
  fi

  if is_real_root_prefix; then
    if ! getent passwd "$user" >/dev/null 2>&1; then
      useradd --system --home-dir "$state" --shell /usr/sbin/nologin "$user" \
        || die "cannot create service account $user"
      note "created service account $user"
    else
      note "service account $user already present"
    fi
  else
    note "staging root in use; service account $user is not created"
  fi

  mkdir -p "$lib" "$state" "$projects" "$keys" || die "cannot create authority directories"
  chmod 0755 "$lib" "$state" "$projects" || die "cannot set directory modes"
  chmod 0700 "$keys" || die "cannot set key directory mode"
  if is_real_root_prefix; then
    chown root:root "$lib" "$state" || die "cannot set ownership"
    chown "$user":"$user" "$projects" "$keys" || die "cannot set ownership"
  fi

  local source target
  for name in $AUTHORITY_INSTALLED_FILES; do
    source="$AUTHORITY_SELF_DIR/$name"
    [ -f "$source" ] || die "missing distribution file: $name"
    target="$lib/$name"
    if [ -e "$target" ] && cmp -s "$source" "$target"; then
      note "$name already current"
    else
      atomic_write "$target" 0755 < "$source"
      is_real_root_prefix && chown root:root "$target"
      note "installed $target"
    fi
  done

  printf '%s\n' "$AUTHORITY_SCHEMA" | atomic_write "$state/schema" 0644
  note "authority ready under $state"
}

cmd_enroll() {
  local workspace="" exec_user="" exec_path="" assume_yes=0 dry_run=0
  local extra_env=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --exec-user) exec_user="$2"; shift 2 ;;
      --exec-path) exec_path="$2"; shift 2 ;;
      --env) extra_env+=("$2"); shift 2 ;;
      --yes) assume_yes=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown enroll option: $1" ;;
      *) [ -z "$workspace" ] || die "only one workspace may be enrolled at a time"; workspace="$1"; shift ;;
    esac
  done
  [ -n "$workspace" ] || die "enroll requires a workspace path"
  [ -n "$exec_user" ] || exec_user=${SUDO_USER:-$(id -un)}
  [ -n "$exec_path" ] || exec_path="$AUTHORITY_DEFAULT_EXEC_PATH"

  local projects; projects=$(projects_dir)
  [ -d "$projects" ] || die "authority is not installed under $(state_dir); run install first"
  assert_safe_dir "$projects"

  local canonical; canonical=$(realpath "$workspace" 2>/dev/null) \
    || die "workspace does not resolve: $workspace"
  [ -d "$canonical" ] || die "workspace is not a directory: $canonical"
  local git_state; git_state=$(authority_git_state "$canonical")
  case "$git_state" in
    directory) ;;
    file) die "workspace uses a linked worktree (.git is a file); this is not supported yet" ;;
    *) die "workspace is not a Git repository: $canonical" ;;
  esac

  local existing; existing=$(find_project_by_workspace "$canonical")
  [ -z "$existing" ] || die "workspace is already enrolled as $existing; revoke it before enrolling again"

  local uid home gids
  uid=$(uid_of_user "$exec_user") || die "unknown execution user: $exec_user"
  home=$(home_of_user "$exec_user") || die "cannot resolve home for $exec_user"
  gids=$(gids_of_user "$exec_user") || die "cannot resolve groups for $exec_user"

  local contract
  contract=$(authority_read_contract "$canonical/agent-md.toml") \
    || die "verification contract refused: $AUTHORITY_CONTRACT_ERROR"
  local contract_fp; contract_fp=$(printf '%s' "$contract" | jq -cS . | sha256_hex) \
    || die "cannot fingerprint the contract"

  local mechanism; mechanism=$(read_mechanism "$canonical") \
    || die "mechanism files are missing or unreadable in $canonical"

  local environment; environment=$(build_environment "$home" "$exec_path" "${extra_env[@]+"${extra_env[@]}"}") || exit 1
  local path_report; path_report=$(build_path_report "$exec_path" "$uid" "$gids")
  local path_ok; path_ok=$(printf '%s' "$path_report" | jq 'all(.[]; .status == "eligible")')

  local status reasons
  reasons='[]'; status=eligible
  if [ "$path_ok" != true ]; then
    status=ineligible
    reasons=$(printf '%s' "$path_report" | jq -c '[.[] | select(.status != "eligible")
      | "PATH entry \(.entry): \(.reason)"]')
  fi

  local project_id; project_id=$(new_uuid)
  local record
  record=$(jq -n \
    --argjson schema "$AUTHORITY_SCHEMA" \
    --arg project_id "$project_id" \
    --arg workspace "$canonical" \
    --arg exec_user "$exec_user" \
    --argjson exec_uid "$uid" \
    --argjson contract "$contract" \
    --arg contract_fingerprint "$contract_fp" \
    --argjson mechanism "$mechanism" \
    --argjson environment "$environment" \
    --argjson path_eligibility "$path_report" \
    --arg status "$status" \
    --argjson reasons "$reasons" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{
      schema: $schema,
      project_id: $project_id,
      workspace: $workspace,
      execution: {user: $exec_user, uid: $exec_uid},
      approved_contract: $contract,
      approved_contract_fingerprint: $contract_fingerprint,
      approved_mechanism: $mechanism,
      approved_environment: $environment,
      path_eligibility: $path_eligibility,
      status: $status,
      reasons: $reasons,
      metadata: {created: $created, note: "timestamps are descriptive and are never used for ordering or authority"}
    }')

  present_enrollment "$record"

  if [ "$dry_run" -eq 1 ]; then
    note ""; note "dry run: nothing was written."
    return 0
  fi
  if [ "$assume_yes" -ne 1 ]; then
    printf '\nApprove this enrollment? [y/N] '
    local answer; read -r answer
    case "$answer" in y|Y|yes|YES) ;; *) die "enrollment declined; nothing was written" ;; esac
  fi

  local dir="$projects/$project_id"
  mkdir -p "$dir" || die "cannot create $dir"
  chmod 0755 "$dir"
  printf '%s\n' "$record" | atomic_write "$dir/enrollment.json" 0644
  jq -nc --argjson schema "$AUTHORITY_SCHEMA" \
    '{schema: $schema, last_terminal: null, pending: null}' \
    | atomic_write "$dir/state.json" 0644
  note ""
  note "enrolled $canonical as $project_id ($status)"
}

present_enrollment() {
  local record="$1"
  note "Enrollment for review"
  note "---------------------"
  note "workspace:      $(printf '%s' "$record" | jq -r '.workspace')"
  note "execution user: $(printf '%s' "$record" | jq -r '.execution.user') (uid $(printf '%s' "$record" | jq -r '.execution.uid'))"
  note ""
  note "commands the issuer would be allowed to run:"
  printf '%s' "$record" | jq -r '.approved_contract.checks[] | "  \(.name): \(.command)"'
  local excluded
  excluded=$(printf '%s' "$record" | jq -r '.approved_contract.excluded_conditional | length')
  if [ "$excluded" -gt 0 ]; then
    note ""
    note "configured but never run by the issuer (separate Risk authority):"
    printf '%s' "$record" | jq -r '.approved_contract.excluded_conditional[] | "  \(.name): \(.command)"'
  fi
  note ""
  note "required checks: $(printf '%s' "$record" | jq -r 'if (.approved_contract.required | length) == 0 then "(none declared)" else (.approved_contract.required | join(", ")) end')"
  note "contract fingerprint: $(printf '%s' "$record" | jq -r '.approved_contract_fingerprint')"
  note ""
  note "mechanism identities:"
  printf '%s' "$record" | jq -r '.approved_mechanism[] | "  \(.path)  \(.digest)"'
  note ""
  note "execution environment:"
  printf '%s' "$record" | jq -r '.approved_environment[] | "  \(.name)=\(.value)"'
  note ""
  note "PATH eligibility:"
  printf '%s' "$record" | jq -r '.path_eligibility[] | "  [\(.status)] \(.entry)\(if .reason == "" then "" else " — \(.reason)" end)"'
  note ""
  note "status: $(printf '%s' "$record" | jq -r '.status')"
  printf '%s' "$record" | jq -r '.reasons[]? | "  reason: \(.)"'
}

cmd_show() {
  local project_id="" workspace=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --workspace) workspace="$2"; shift 2 ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown show option: $1" ;;
      *) project_id="$1"; shift ;;
    esac
  done
  if [ -n "$workspace" ]; then
    local canonical; canonical=$(realpath "$workspace" 2>/dev/null) || die "workspace does not resolve"
    project_id=$(find_project_by_workspace "$canonical")
    [ -n "$project_id" ] || die "no enrollment for $canonical"
  fi
  [ -n "$project_id" ] || die "show requires a project id or --workspace"
  case "$project_id" in */*|..|.) die "invalid project id" ;; esac

  local file
  file="$(projects_dir)/$project_id/enrollment.json"
  [ -f "$file" ] || die "no enrollment for $project_id"
  if path_has_symlink "$file"; then die "refusing to read $file: a path component is a symlink"; fi

  local record; record=$(cat "$file")
  note "project id:     $(printf '%s' "$record" | jq -r '.project_id')"
  present_enrollment "$record"
}

[ $# -gt 0 ] || { usage; exit 1; }
command -v jq >/dev/null 2>&1 || die "jq is required"
subcommand="$1"; shift
case "$subcommand" in
  install) cmd_install "$@" ;;
  enroll) cmd_enroll "$@" ;;
  show) cmd_show "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown subcommand: $subcommand" ;;
esac
