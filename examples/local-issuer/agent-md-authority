#!/bin/bash
# agent-md-authority — enrollment authority for verification receipts.
#
# Decides which projects may ever receive an authenticated verification
# receipt, and records exactly what a future issuer would be allowed to run on
# their behalf. A repository can request capability; it can never grant
# capability to itself.
#
# install, enroll and show only. Issuing receipts, executing checks, signing
# and sequence allocation live in later slices and are absent here on purpose.

# PROGRAM and ROOT are consumed by authority-lib.sh. shellcheck only follows a
# sourced file when invoked with -x, so these directives keep the program
# clean under either invocation.
# shellcheck disable=SC2034
set -u
PROGRAM=${0##*/}

AUTHORITY_SELF_DIR=$(cd "$(dirname "$(realpath "$0")")" && pwd)
# shellcheck source=examples/local-issuer/authority-lib.sh
# shellcheck disable=SC1091
. "$AUTHORITY_SELF_DIR/authority-lib.sh"

usage() {
  cat <<'USAGE'
Usage:
  agent-md-authority install [--root PREFIX] [--user NAME] [--dry-run]
  agent-md-authority enroll  WORKSPACE [--root PREFIX] [--exec-user NAME]
                             [--exec-path VALUE] [--env NAME=VALUE]...
                             [--yes] [--dry-run]
  agent-md-authority show    (PROJECT_ID | --workspace PATH) [--root PREFIX]
  agent-md-authority prepare-run PROJECT_ID [--check NAME] [--root PREFIX]
  agent-md-authority prepare-job PROJECT_ID --check NAME [--root PREFIX]
  agent-md-authority sudoers PROJECT_ID [--root PREFIX] [--write]
  agent-md-authority enumerate PROJECT_ID

Options:
  --root PREFIX   Operate under an alternate filesystem root. Intended for
                  tests and staging; the real installation uses /.
  --yes           Accept the presented enrollment without prompting. This is a
                  command-line flag on purpose; no environment variable
                  approves an enrollment.
USAGE
}

new_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  elif command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 16
  else
    die "no source of unique identifiers is available"
  fi
}

AUTHORITY_INSTALLED_FILES="authority-lib.sh agent-md-authority agent-md-issuer run-check"

cmd_install() {
  local user=agentmd dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --user) user="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown install option: $1" ;;
    esac
  done

  if is_real_root_prefix && [ "$(id -u)" != 0 ]; then
    die "install must run as root; re-run with sudo, or pass --root PREFIX for a staging tree"
  fi

  local lib state projects keys
  lib=$(lib_dir); state=$(state_dir); projects=$(projects_dir); keys=$(keys_dir)
  assert_safe_dir "$lib"; assert_safe_dir "$state"
  assert_safe_dir "$projects"; assert_safe_dir "$keys"

  local name
  if [ "$dry_run" -eq 1 ]; then
    note "would ensure service account: $user"
    note "would create $lib (root, 0755)"
    note "would create $state (root, 0755)"
    note "would create $projects ($user, 0755)"
    note "would create $keys ($user, 0700)"
    for name in $AUTHORITY_INSTALLED_FILES; do
      note "would install $lib/$name (root, 0755)"
    done
    return 0
  fi

  if is_real_root_prefix; then
    if ! getent passwd "$user" >/dev/null 2>&1; then
      useradd --system --home-dir "$state" --shell /usr/sbin/nologin "$user" \
        || die "cannot create service account $user"
      note "created service account $user"
    else
      note "service account $user already present"
    fi
  else
    note "staging root in use; service account $user is not created"
  fi

  mkdir -p "$lib" "$state" "$projects" "$keys" || die "cannot create authority directories"
  chmod 0755 "$lib" "$state" "$projects" || die "cannot set directory modes"
  chmod 0700 "$keys" || die "cannot set key directory mode"
  if is_real_root_prefix; then
    chown root:root "$lib" "$state" || die "cannot set ownership"
    chown "$user":"$user" "$projects" "$keys" || die "cannot set ownership"
  fi

  local source target
  for name in $AUTHORITY_INSTALLED_FILES; do
    source="$AUTHORITY_SELF_DIR/$name"
    [ -f "$source" ] || die "missing distribution file: $name"
    target="$lib/$name"
    if [ -e "$target" ] && cmp -s "$source" "$target"; then
      note "$name already current"
    else
      atomic_write "$target" 0755 < "$source"
      is_real_root_prefix && chown root:root "$target"
      note "installed $target"
    fi
  done

  # The runner needs somewhere writable for temporary and build output that is
  # outside the snapshot. It is wiped per run, so nothing has to survive.
  mkdir -p "$ROOT$AUTHORITY_SCRATCH_ROOT" || die "cannot create the runner scratch root"
  chmod 0700 "$ROOT$AUTHORITY_SCRATCH_ROOT"
  if is_real_root_prefix && getent passwd "$AUTHORITY_RUNNER_USER" >/dev/null 2>&1; then
    chown "$AUTHORITY_RUNNER_USER":"$AUTHORITY_RUNNER_USER" "$ROOT$AUTHORITY_SCRATCH_ROOT"
  fi

  printf '%s\n' "$AUTHORITY_SCHEMA" | atomic_write "$state/schema" 0644
  note "authority ready under $state"
}

cmd_enroll() {
  local workspace="" exec_user="" exec_path="" assume_yes=0 dry_run=0
  local extra_env=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --exec-user) exec_user="$2"; shift 2 ;;
      --exec-path) exec_path="$2"; shift 2 ;;
      --env) extra_env+=("$2"); shift 2 ;;
      --yes) assume_yes=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown enroll option: $1" ;;
      *) [ -z "$workspace" ] || die "only one workspace may be enrolled at a time"; workspace="$1"; shift ;;
    esac
  done
  [ -n "$workspace" ] || die "enroll requires a workspace path"
  [ -n "$exec_user" ] || exec_user=${SUDO_USER:-$(id -un)}
  [ -n "$exec_path" ] || exec_path="$AUTHORITY_DEFAULT_EXEC_PATH"

  local projects; projects=$(projects_dir)
  [ -d "$projects" ] || die "authority is not installed under $(state_dir); run install first"
  assert_safe_dir "$projects"

  local canonical; canonical=$(realpath "$workspace" 2>/dev/null) \
    || die "workspace does not resolve: $workspace"
  [ -d "$canonical" ] || die "workspace is not a directory: $canonical"
  local git_state; git_state=$(authority_git_state "$canonical")
  case "$git_state" in
    directory) ;;
    file) die "workspace uses a linked worktree (.git is a file); this is not supported yet" ;;
    *) die "workspace is not a Git repository: $canonical" ;;
  esac

  local existing; existing=$(find_project_by_workspace "$canonical")
  [ -z "$existing" ] || die "workspace is already enrolled as $existing; revoke it before enrolling again"

  local uid home gids
  uid=$(uid_of_user "$exec_user") || die "unknown execution user: $exec_user"
  home=$(home_of_user "$exec_user") || die "cannot resolve home for $exec_user"
  gids=$(gids_of_user "$exec_user") || die "cannot resolve groups for $exec_user"

  local contract contract_err
  contract_err=$(mktemp "${TMPDIR:-/tmp}/agent-md-contract-err.XXXXXX") || die "cannot create a temporary file"
  if ! contract=$(authority_read_contract "$canonical/agent-md.toml" 2>"$contract_err"); then
    local reason; reason=$(cat "$contract_err"); rm -f "$contract_err"
    die "verification contract refused: ${reason:-unknown}"
  fi
  rm -f "$contract_err"
  local contract_fp; contract_fp=$(printf '%s' "$contract" | jq -cS . | sha256_hex) \
    || die "cannot fingerprint the contract"

  local mechanism; mechanism=$(read_mechanism "$canonical") \
    || die "mechanism files are missing or unreadable in $canonical"

  local tools; tools=$(authority_discover_tools "$uid" "$gids") \
    || die "no trusted runtime tool set could be approved: $tools"

  local environment; environment=$(build_environment "$home" "$exec_path" "${extra_env[@]+"${extra_env[@]}"}") || exit 1
  local path_report; path_report=$(build_path_report "$exec_path" "$uid" "$gids")
  local path_ok; path_ok=$(printf '%s' "$path_report" | jq 'all(.[]; .status == "eligible")')

  local status reasons
  reasons='[]'; status=eligible
  if [ "$path_ok" != true ]; then
    status=ineligible
    reasons=$(printf '%s' "$path_report" | jq -c '[.[] | select(.status != "eligible")
      | "PATH entry \(.entry): \(.reason)"]')
  fi

  local project_id; project_id=$(new_uuid)
  local record
  record=$(jq -n \
    --argjson schema "$AUTHORITY_SCHEMA" \
    --arg project_id "$project_id" \
    --arg workspace "$canonical" \
    --arg exec_user "$exec_user" \
    --argjson exec_uid "$uid" \
    --argjson contract "$contract" \
    --arg contract_fingerprint "$contract_fp" \
    --argjson mechanism "$mechanism" \
    --argjson environment "$environment" \
    --argjson path_eligibility "$path_report" \
    --argjson tools "$tools" \
    --arg status "$status" \
    --argjson reasons "$reasons" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{
      schema: $schema,
      project_id: $project_id,
      workspace: $workspace,
      execution: {user: $exec_user, uid: $exec_uid},
      approved_contract: $contract,
      approved_contract_fingerprint: $contract_fingerprint,
      approved_mechanism: $mechanism,
      approved_environment: $environment,
      approved_tools: $tools,
      path_eligibility: $path_eligibility,
      status: $status,
      reasons: $reasons,
      metadata: {created: $created, note: "timestamps are descriptive and are never used for ordering or authority"}
    }')

  present_enrollment "$record"

  if [ "$dry_run" -eq 1 ]; then
    note ""; note "dry run: nothing was written."
    return 0
  fi
  if [ "$assume_yes" -ne 1 ]; then
    printf '\nApprove this enrollment? [y/N] '
    local answer; read -r answer
    case "$answer" in y|Y|yes|YES) ;; *) die "enrollment declined; nothing was written" ;; esac
  fi

  local dir="$projects/$project_id"
  mkdir -p "$dir" || die "cannot create $dir"
  chmod 0755 "$dir"
  printf '%s\n' "$record" | atomic_write "$dir/enrollment.json" 0644
  jq -nc --argjson schema "$AUTHORITY_SCHEMA" \
    '{schema: $schema, last_terminal: null, pending: null}' \
    | atomic_write "$dir/state.json" 0644
  note ""
  note "enrolled $canonical as $project_id ($status)"
}

present_enrollment() {
  local record="$1"
  note "Enrollment for review"
  note "---------------------"
  note "workspace:      $(printf '%s' "$record" | jq -r '.workspace')"
  note "execution user: $(printf '%s' "$record" | jq -r '.execution.user') (uid $(printf '%s' "$record" | jq -r '.execution.uid'))"
  note ""
  note "commands the issuer would be allowed to run:"
  printf '%s' "$record" | jq -r '.approved_contract.checks[] | "  \(.name): \(.command)"'
  local excluded
  excluded=$(printf '%s' "$record" | jq -r '.approved_contract.excluded_conditional | length')
  if [ "$excluded" -gt 0 ]; then
    note ""
    note "configured but never run by the issuer (separate Risk authority):"
    printf '%s' "$record" | jq -r '.approved_contract.excluded_conditional[] | "  \(.name): \(.command)"'
  fi
  note ""
  note "required checks: $(printf '%s' "$record" | jq -r 'if (.approved_contract.required | length) == 0 then "(none declared)" else (.approved_contract.required | join(", ")) end')"
  note "contract fingerprint: $(printf '%s' "$record" | jq -r '.approved_contract_fingerprint')"
  note ""
  note "mechanism identities:"
  printf '%s' "$record" | jq -r '.approved_mechanism[] | "  \(.path)  \(.digest)"'
  note ""
  note "execution environment:"
  printf '%s' "$record" | jq -r '.approved_environment[] | "  \(.name)=\(.value)"'
  note ""
  note "trusted runtime tools:"
  printf '%s' "$record" | jq -r '.approved_tools[]? | "  \(.name) -> \(.path)"'
  note ""
  note "PATH eligibility:"
  printf '%s' "$record" | jq -r '.path_eligibility[] | "  [\(.status)] \(.entry)\(if .reason == "" then "" else " — \(.reason)" end)"'
  note ""
  note "status: $(printf '%s' "$record" | jq -r '.status')"
  printf '%s' "$record" | jq -r '.reasons[]? | "  reason: \(.)"'
}

# Prepares one evaluation run: a fresh sealed snapshot plus one job per
# approved check. A run is the unit of isolation. Replacing a single mutable
# snapshot directory used to be able to delete the tree a check was still
# executing in, so every evaluation now materialises its own run and the
# pointer to the current one is authority-owned.
#
# Preparation is serialized per project. Two evaluations of the same project do
# not interleave: the second waits briefly and is refused rather than racing.
cmd_prepare_run() {
  local project_id="" only_check=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --check) only_check="$2"; shift 2 ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown prepare-run option: $1" ;;
      *) project_id="$1"; shift ;;
    esac
  done
  [ -n "$project_id" ] || die "prepare-run requires a project id"
  case "$project_id" in */*|..|.|*[!a-zA-Z0-9-]*) die "invalid project id" ;; esac
  command -v flock >/dev/null 2>&1 || die "flock is required to serialize evaluations"

  local dir file record
  dir="$(projects_dir)/$project_id"
  file="$dir/enrollment.json"
  [ -f "$file" ] || die "no enrollment for $project_id"
  path_has_symlink "$file" && die "enrollment path traverses a symlink"
  record=$(cat "$file")
  [ "$(printf '%s' "$record" | jq -r '.schema')" = "$AUTHORITY_SCHEMA" ] \
    || die "enrollment uses an unsupported schema; re-enroll"
  [ "$(printf '%s' "$record" | jq -r '.status')" = eligible ] \
    || die "enrollment is not eligible; refusing to prepare a run"

  # The project directory is sealed between runs so nothing but the authority
  # can introduce a file next to the pointer a check will trust. The authority
  # owns it, so it unseals to publish and seals again.
  chmod u+w "$dir" 2>/dev/null || true

  local lock; lock=$(authority_project_lock "$project_id")
  exec 9>"$lock" || die "cannot open the project lock"
  flock -w 5 9 || die "another evaluation is already preparing this project"

  local timeout
  timeout=$(printf '%s' "$record" | jq -r '.approved_contract.timeout_seconds // empty')
  [ -n "$timeout" ] || die "the approved contract declares no per-check timeout"

  # Which checks this run will carry, in the core's canonical order.
  local ordered=() name command
  for name in $AUTHORITY_CHECK_ORDER; do
    [ -z "$only_check" ] || [ "$name" = "$only_check" ] || continue
    command=$(printf '%s' "$record" | jq -r --arg c "$name" \
      '.approved_contract.checks[] | select(.name == $c) | .command' | head -1)
    [ -n "$command" ] || continue
    ordered+=("$name")
  done
  if [ "${#ordered[@]}" -eq 0 ]; then
    if [ -n "$only_check" ]; then
      die "check '$only_check' is not part of the approved contract"
    fi
    die "the approved contract carries no ordinary check"
  fi

  local run_id run_dir
  run_id=$(new_uuid)
  authority_run_id_is_safe "$run_id" || die "generated run id is malformed"
  run_dir=$(authority_run_dir "$project_id" "$run_id")
  mkdir -p "$run_dir/jobs" || die "cannot create the run directory"

  local workspace paths reason manifest fingerprint
  workspace=$(printf '%s' "$record" | jq -r '.workspace')
  paths=$(mktemp "${TMPDIR:-/tmp}/agent-md-paths.XXXXXX") || die "cannot create a path list"
  if ! authority_enumerate_for "$workspace" "$project_id" > "$paths"; then
    rm -f "$paths"; die "could not enumerate the workspace"
  fi
  if ! reason=$(authority_materialize_snapshot "$workspace" "$paths" "$run_dir/snapshot/src"); then
    rm -f "$paths"
    chmod -R u+w "$run_dir" 2>/dev/null || true
    rm -rf "${run_dir:?}"
    die "snapshot refused: $reason"
  fi
  rm -f "$paths"
  authority_seal_snapshot "$run_dir/snapshot/src"
  manifest=$(authority_snapshot_manifest "$run_dir/snapshot/src") || die "cannot fingerprint the snapshot"
  fingerprint=$(printf '%s' "$manifest" | jq -cS . | sha256_hex) || die "cannot fingerprint the snapshot"
  printf '%s\n' "$manifest" | atomic_write "$run_dir/snapshot/manifest.json" 0444

  local runner total
  runner=$(authority_runner_identity) || die "cannot resolve the execution account: $runner"
  total=$(authority_derive_total_timeout "$timeout" "${#ordered[@]}" \
    "$(printf '%s' "$record" | jq -r '.approved_contract.total_timeout_seconds // empty')")

  # Every check of this run reads the same sealed snapshot and the same
  # approved environment. Nothing is recaptured between checks.
  local job
  for name in "${ordered[@]}"; do
    command=$(printf '%s' "$record" | jq -r --arg c "$name" \
      '.approved_contract.checks[] | select(.name == $c) | .command' | head -1)
    job=$(jq -n \
      --argjson schema "$AUTHORITY_SCHEMA" \
      --arg project_id "$project_id" \
      --arg run_id "$run_id" \
      --arg workspace "$workspace" \
      --arg snapshot "$run_dir/snapshot/src" \
      --arg snapshot_fingerprint "$fingerprint" \
      --argjson execution "$runner" \
      --argjson developer "$(printf '%s' "$record" | jq -c '.execution')" \
      --arg check "$name" \
      --arg command "$command" \
      --argjson environment "$(printf '%s' "$record" | jq -c '.approved_environment')" \
      --argjson timeout_seconds "$timeout" \
      --argjson tools "$(printf '%s' "$record" | jq -c '.approved_tools')" \
      '{schema: $schema, project_id: $project_id, run_id: $run_id, workspace: $workspace,
        snapshot: $snapshot, snapshot_fingerprint: $snapshot_fingerprint,
        execution: $execution, developer: $developer, check: $check, command: $command,
        environment: $environment, timeout_seconds: $timeout_seconds, tools: $tools}')
    printf '%s\n' "$job" | atomic_write "$run_dir/jobs/$name.json" 0444
  done
  chmod 0555 "$run_dir/jobs" 2>/dev/null || true

  # The pointer is published only once the run is complete, so a reader never
  # observes a half-built run.
  printf '%s\n' "$run_id" | atomic_write "$(authority_current_run_file "$project_id")" 0444

  # Older runs are removed now that nothing points at them. The current one is
  # never a candidate, so a check executing in it cannot lose its ground.
  local old
  for old in "$(authority_runs_root "$project_id")"/*/; do
    [ -d "$old" ] || continue
    case "$old" in *"/$run_id/") continue ;; esac
    chmod -R u+w "$old" 2>/dev/null || true
    rm -rf "${old:?}"
  done

  chmod 0555 "$dir" 2>/dev/null || true

  printf 'run %s\n' "$run_id"
  note "execution account: $(printf '%s' "$runner" | jq -r '.user') (uid $(printf '%s' "$runner" | jq -r '.uid'))"
  note "snapshot sealed at $run_dir/snapshot/src ($(printf '%s' "$manifest" | jq 'length') entries)"
  note "jobs: ${ordered[*]}"
  note "per-check timeout ${timeout}s, total ${total}s"
}

# Compatibility entry point for a single check; a run is still created.
cmd_prepare_job() {
  cmd_prepare_run "$@"
}

# The descending sudo rule. It names one target user and one literal project id,
# so an authority operating project A cannot reach project B's rule, and no rule
# ever authorises root or a free-form command.
# In production the enumeration crosses into the execution-only account, so a
# repository that manages to execute code through its own Git configuration
# reaches the runner and never the authority. A staging root has no such
# account, and the skipped hop is announced rather than hidden.
authority_enumerate_for() {
  local workspace="$1" project_id="$2"
  if is_real_root_prefix && getent passwd "$AUTHORITY_RUNNER_USER" >/dev/null 2>&1; then
    sudo -n -u "$AUTHORITY_RUNNER_USER" "$(lib_dir)/agent-md-authority" enumerate "$project_id"
    return $?
  fi
  note "staging root: enumerating without the runner hop" >&2
  authority_enumerate_paths "$workspace"
}

cmd_sudoers() {
  local project_id="" write=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --write) write=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown sudoers option: $1" ;;
      *) project_id="$1"; shift ;;
    esac
  done
  [ -n "$project_id" ] || die "sudoers requires a project id"
  case "$project_id" in */*|..|.) die "invalid project id" ;; esac
  case "$project_id" in *[!a-zA-Z0-9-]*) die "invalid project id" ;; esac

  local file record exec_user alias policy
  file="$(projects_dir)/$project_id/enrollment.json"
  [ -f "$file" ] || die "no enrollment for $project_id"
  record=$(cat "$file")
  exec_user=$(printf '%s' "$record" | jq -r '.execution.user')
  [ -n "$exec_user" ] || die "enrollment declares no execution user"
  case "$exec_user" in root) die "refusing to generate a rule targeting root" ;; esac

  local checks entries name
  checks=$(printf '%s' "$record" | jq -r '.approved_contract.checks[].name')
  alias="AGENTMD_$(printf '%s' "$project_id" | tr -d - | tr '[:lower:]' '[:upper:]')"
  entries=""
  for name in $AUTHORITY_CHECK_ORDER; do
    printf '%s\n' "$checks" | grep -qxF "$name" || continue
    entries="${entries}    $(lib_dir)/run-check $project_id $name, \\"$'\n'
  done
  [ -n "$entries" ] || die "the approved contract carries no ordinary check"

  policy=$(cat <<POLICY
# coding-agent-control verification authority
# Project $project_id, enrolled for developer $exec_user.
#
# Two hops, each as narrow as the interface allows.
#
# The inner rule never targets the developer. Checks run as a dedicated
# execution-only account, so the developer, who is untrusted, cannot signal or
# ptrace the process observing the result and cannot reach the snapshot.
# Every command is a literal path with literal arguments: one project id and
# one approved check name per entry. There is no wildcard anywhere, so no
# argument a caller could influence is ever matched loosely, and the run
# identifier is resolved from authority-owned state rather than passed in.
#
# The outer rule lets the enrolled developer ask for an evaluation and nothing
# else. It reaches one subcommand of the issuer, never a shell, never the
# administrative CLI, never run-check, never root, never another user. The
# request travels on stdin, so the rule needs no argument at all.
#
# Neither rule grants SETENV: a caller cannot carry environment across either
# boundary.
Defaults!$alias env_reset, secure_path="/usr/local/bin:/usr/bin:/bin"
Defaults!${alias}_EVAL env_reset, secure_path="/usr/local/bin:/usr/bin:/bin"
Cmnd_Alias $alias = \\
${entries}    $(lib_dir)/agent-md-authority enumerate $project_id
Cmnd_Alias ${alias}_EVAL = $(lib_dir)/agent-md-issuer evaluate
$AUTHORITY_SERVICE_USER ALL=($AUTHORITY_RUNNER_USER) NOPASSWD: $alias
$exec_user ALL=($AUTHORITY_SERVICE_USER) NOPASSWD: ${alias}_EVAL
POLICY
)
  if [ "$write" -eq 1 ]; then
    local target="$ROOT/etc/sudoers.d"
    mkdir -p "$target" || die "cannot create $target"
    printf '%s\n' "$policy" | atomic_write "$target/agent-md-$project_id" 0440
    note "wrote $target/agent-md-$project_id"
  else
    printf '%s\n' "$policy"
  fi
}

# Emits the worktree path set. This is the only code path that reads a
# repository's own Git configuration, so it is meant to be reached through the
# descending sudo rule and to run as the execution-only account.
cmd_enumerate() {
  local project_id="${1:-}" root_prefix="${2:-}" file workspace
  [ -n "$project_id" ] || die "enumerate requires a project id"
  [ -z "$root_prefix" ] || ROOT=${root_prefix%/}
  case "$project_id" in */*|..|.|*[!a-zA-Z0-9-]*) die "invalid project id" ;; esac
  file="$(projects_dir)/$project_id/enrollment.json"
  [ -f "$file" ] || die "no enrollment for $project_id"
  path_has_symlink "$file" && die "enrollment path traverses a symlink"
  workspace=$(jq -r '.workspace // empty' "$file")
  [ -n "$workspace" ] || die "enrollment declares no workspace"
  case "$workspace" in /*) ;; *) die "enrollment workspace is not absolute" ;; esac
  [ -d "$workspace" ] || die "enrollment workspace is not a directory"
  authority_enumerate_paths "$workspace"
}

cmd_show() {
  local project_id="" workspace=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      --workspace) workspace="$2"; shift 2 ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown show option: $1" ;;
      *) project_id="$1"; shift ;;
    esac
  done
  if [ -n "$workspace" ]; then
    local canonical; canonical=$(realpath "$workspace" 2>/dev/null) || die "workspace does not resolve"
    project_id=$(find_project_by_workspace "$canonical")
    [ -n "$project_id" ] || die "no enrollment for $canonical"
  fi
  [ -n "$project_id" ] || die "show requires a project id or --workspace"
  case "$project_id" in */*|..|.) die "invalid project id" ;; esac

  local file
  file="$(projects_dir)/$project_id/enrollment.json"
  [ -f "$file" ] || die "no enrollment for $project_id"
  if path_has_symlink "$file"; then die "refusing to read $file: a path component is a symlink"; fi

  local record; record=$(cat "$file")
  note "project id:     $(printf '%s' "$record" | jq -r '.project_id')"
  present_enrollment "$record"
}

[ $# -gt 0 ] || { usage; exit 1; }
command -v jq >/dev/null 2>&1 || die "jq is required"
subcommand="$1"; shift
case "$subcommand" in
  install) cmd_install "$@" ;;
  enroll) cmd_enroll "$@" ;;
  show) cmd_show "$@" ;;
  enumerate) cmd_enumerate "$@" ;;
  prepare-run) cmd_prepare_run "$@" ;;
  prepare-job) cmd_prepare_job "$@" ;;
  sudoers) cmd_sudoers "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown subcommand: $subcommand" ;;
esac
