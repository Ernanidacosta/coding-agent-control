#!/bin/bash
# agent-md-issuer — runtime authority for verification receipts.
#
# Slice C2 answers exactly one question:
#
#   "does the authority still recognise this project, and would it be
#    authorised to attempt verification in a later slice?"
#
# It cannot answer anything stronger. There is no path in this program that
# executes an approved command, executes anything from the workspace, reads key
# material, allocates a sequence number, signs, or writes a receipt. Those
# arrive in later slices, and their absence here is deliberate.
#
# Protocol: one JSON object on stdin, one JSON object on stdout, human
# diagnostics on stderr, and an exit code that stays meaningful on its own.

# PROGRAM and ROOT are consumed by authority-lib.sh. shellcheck only follows a
# sourced file when invoked with -x, so these directives keep the program
# clean under either invocation.
# shellcheck disable=SC2034
set -u
PROGRAM=${0##*/}

AUTHORITY_SELF_DIR=$(cd "$(dirname "$(realpath "$0")")" && pwd)
# shellcheck source=examples/local-issuer/authority-lib.sh
# shellcheck disable=SC1091
. "$AUTHORITY_SELF_DIR/authority-lib.sh"

ISSUER_PROTOCOL=1

# Exit codes are part of the contract: a caller that cannot parse JSON must
# still be able to route on the outcome. Refusal is never exit 0.
EX_ELIGIBLE=0
EX_MALFORMED_REQUEST=2
EX_UNSUPPORTED_PROTOCOL=3
EX_UNSUPPORTED_SCOPE=4
EX_NOT_ENROLLED=5
EX_AMBIGUOUS_ENROLLMENT=6
EX_CONTRACT_CHANGED=7
EX_MECHANISM_CHANGED=8
EX_ENV_CHANGED=9
EX_ENROLLMENT_CORRUPT=10
EX_AUTHORITY_STATE_UNSAFE=11
EX_WORKSPACE_UNSUPPORTED=12
EX_ENROLLMENT_INELIGIBLE=13
EX_CANDIDATE_FAIL=1
EX_CALLER_UNBOUND=14
EX_CALLER_MISMATCH=15
EX_RUN_FAILED=16
EX_BUDGET_EXHAUSTED=17
EX_EVALUATION_IN_PROGRESS=18
EX_STATE_UNUSABLE=19
EX_INTERNAL=20

RESPONSE_MODE=eligibility
ISSUER_PROJECTS=""
ISSUER_CANONICAL=""
ISSUER_RECORD=""
ISSUER_PROJECT_ID=""
ISSUER_RUN_ID=""
ISSUER_SNAPSHOT_FP=""
ISSUER_SOURCE_FP=""
ISSUER_CALLER_UID=""
ISSUER_CALLER_USER=""
ISSUER_EXHAUSTED=false
ISSUER_SCOPE=""
ISSUER_SEQUENCE=""
ISSUER_TERMINAL_DONE=0
ISSUER_RECOVERED=false
RESPONSE_SEQUENCE=null
RESPONSE_RUN_ID=null
RESPONSE_CALLER=null
RESPONSE_SNAPSHOT=null
RESPONSE_IDENTITY=null
RESPONSE_CHECKS='[]'
RESPONSE_BUDGET=null
RESPONSE_PROJECT_ID=null
RESPONSE_WORKSPACE=null
RESPONSE_SCOPE=null
RESPONSE_CONTRACT='"unknown"'
RESPONSE_MECHANISM='"unknown"'
RESPONSE_ENVIRONMENT='"unknown"'

# Emits the single response object and leaves. Nothing prints to stdout except
# through here, so stdout always holds exactly one JSON object.
respond() {
  local status="$1" code="$2" reason="$3" exit_code="$4"
  if [ "$RESPONSE_MODE" = evaluation ]; then
    jq -nc \
      --argjson protocol "$ISSUER_PROTOCOL" \
      --arg status "$status" --arg reason_code "$code" --arg reason "$reason" \
      --argjson project_id "$RESPONSE_PROJECT_ID" --argjson run_id "$RESPONSE_RUN_ID" \
      --argjson workspace "$RESPONSE_WORKSPACE" --argjson scope "$RESPONSE_SCOPE" \
      --argjson caller "$RESPONSE_CALLER" --argjson snapshot "$RESPONSE_SNAPSHOT" \
      --argjson identity "$RESPONSE_IDENTITY" \
      --argjson contract "$RESPONSE_CONTRACT" --argjson mechanism "$RESPONSE_MECHANISM" \
      --argjson environment "$RESPONSE_ENVIRONMENT" --argjson checks "$RESPONSE_CHECKS" \
      --argjson budget "$RESPONSE_BUDGET" --argjson sequence "$RESPONSE_SEQUENCE" '
        {protocol: $protocol, schema: $protocol, status: $status,
         reason_code: $reason_code, reason: $reason,
         project_id: $project_id, run_id: $run_id, workspace: $workspace, scope: $scope,
         caller: $caller,
         # The sequence this evaluation reserved, or null when it never got as
         # far as reserving one. A reserved sequence is consumed whether or not
         # it ever becomes a terminal result, so this is not a receipt number.
         sequence: $sequence,
         # The four fingerprints the core already understands, bound to this
         # run. A later signing step consumes exactly these; on their own they
         # are orchestration output and carry no authority.
         identity: $identity,
         # The sealed tree the checks actually read, which is a different thing
         # from the source identity and is reported separately.
         snapshot: $snapshot,
         contract: {state: $contract}, mechanism: {state: $mechanism},
         environment: {state: $environment},
         checks: $checks, budget: $budget}'
    [ "$exit_code" -eq 0 ] || printf '%s: %s\n' "$PROGRAM" "$reason" >&2
    exit "$exit_code"
  fi
  jq -nc \
    --argjson protocol "$ISSUER_PROTOCOL" \
    --arg status "$status" \
    --arg reason_code "$code" \
    --arg reason "$reason" \
    --argjson project_id "$RESPONSE_PROJECT_ID" \
    --argjson workspace "$RESPONSE_WORKSPACE" \
    --argjson scope "$RESPONSE_SCOPE" \
    --argjson contract "$RESPONSE_CONTRACT" \
    --argjson mechanism "$RESPONSE_MECHANISM" \
    --argjson environment "$RESPONSE_ENVIRONMENT" \
    '{
      protocol: $protocol,
      status: $status,
      reason_code: $reason_code,
      reason: $reason,
      project_id: $project_id,
      workspace: $workspace,
      scope: $scope,
      contract: {state: $contract},
      mechanism: {state: $mechanism},
      environment: {state: $environment}
    }'
  [ "$exit_code" -eq 0 ] || printf '%s: %s\n' "$PROGRAM" "$reason" >&2
  exit "$exit_code"
}

refuse() { respond refused "$1" "$2" "$3"; }

usage() {
  cat <<'USAGE'
Usage:
  agent-md-issuer eligibility [--root PREFIX] < request.json
  agent-md-issuer evaluate    [--root PREFIX] < request.json

Reads one JSON request object on stdin:

  {"protocol": 1, "scope": "worktree", "workspace": "/absolute/path"}

No other field is accepted. The caller never states what should be executed,
verified or attested; the authority derives all of that from the enrollment.
USAGE
}

cmd_eligibility() {
  issuer_parse_options "$@"
  issuer_resolve_request
  issuer_check_eligibility
  respond eligible ELIGIBLE "the authority recognises this project and would be authorised to attempt verification" "$EX_ELIGIBLE"
}

issuer_parse_options() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) ROOT=${2%/}; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) refuse REFUSED_MALFORMED_REQUEST "unknown option: $1" "$EX_MALFORMED_REQUEST" ;;
    esac
  done
}

issuer_resolve_request() {
  local raw; raw=$(cat)

  # --- request shape ---------------------------------------------------------
  # Exactly one object, exactly the three defined fields, strict types. Any
  # extra field is a caller trying to widen the authority's surface and is
  # rejected rather than ignored.
  if ! printf '%s' "$raw" | jq -e 'type == "object"' >/dev/null 2>&1; then
    refuse REFUSED_MALFORMED_REQUEST "request must be exactly one JSON object" "$EX_MALFORMED_REQUEST"
  fi
  local extra
  extra=$(printf '%s' "$raw" | jq -r '[keys_unsorted[] | select(. != "protocol" and . != "scope" and . != "workspace")] | join(", ")')
  if [ -n "$extra" ]; then
    refuse REFUSED_MALFORMED_REQUEST "request carries fields the caller may not set: $extra" "$EX_MALFORMED_REQUEST"
  fi
  if ! printf '%s' "$raw" | jq -e '(.protocol | type) == "number"' >/dev/null 2>&1; then
    refuse REFUSED_MALFORMED_REQUEST "protocol must be a number" "$EX_MALFORMED_REQUEST"
  fi
  if ! printf '%s' "$raw" | jq -e '(.scope | type) == "string" and (.workspace | type) == "string"' >/dev/null 2>&1; then
    refuse REFUSED_MALFORMED_REQUEST "scope and workspace must be strings" "$EX_MALFORMED_REQUEST"
  fi

  local protocol scope workspace
  protocol=$(printf '%s' "$raw" | jq -r '.protocol')
  scope=$(printf '%s' "$raw" | jq -r '.scope')
  workspace=$(printf '%s' "$raw" | jq -r '.workspace')

  [ "$protocol" = "$ISSUER_PROTOCOL" ] || \
    refuse REFUSED_UNSUPPORTED_PROTOCOL "unsupported protocol: $protocol" "$EX_UNSUPPORTED_PROTOCOL"

  RESPONSE_SCOPE=$(json_string "$scope")
  ISSUER_SCOPE="$scope"
  case "$scope" in
    worktree) ;;
    staged) refuse REFUSED_UNSUPPORTED_SCOPE "staged scope is not supported yet" "$EX_UNSUPPORTED_SCOPE" ;;
    *) refuse REFUSED_UNSUPPORTED_SCOPE "unknown scope: $scope" "$EX_UNSUPPORTED_SCOPE" ;;
  esac

  case "$workspace" in
    /*) ;;
    *) refuse REFUSED_MALFORMED_REQUEST "workspace must be an absolute path" "$EX_MALFORMED_REQUEST" ;;
  esac

  # --- authority state -------------------------------------------------------
  local safety
  ISSUER_PROJECTS=$(projects_dir)
  projects="$ISSUER_PROJECTS"
  if ! safety=$(authority_dir_safety "$projects"); then
    refuse REFUSED_AUTHORITY_STATE_UNSAFE "authority project store is unusable: $safety" "$EX_AUTHORITY_STATE_UNSAFE"
  fi

  # --- workspace -------------------------------------------------------------
  local canonical
  canonical=$(realpath "$workspace" 2>/dev/null) || \
    refuse REFUSED_NOT_ENROLLED "workspace does not resolve" "$EX_NOT_ENROLLED"
  ISSUER_CANONICAL="$canonical"
  RESPONSE_WORKSPACE=$(json_string "$canonical")
  [ -d "$canonical" ] || \
    refuse REFUSED_NOT_ENROLLED "workspace is not a directory" "$EX_NOT_ENROLLED"

  case "$(authority_git_state "$canonical")" in
    directory) ;;
    file) refuse REFUSED_WORKSPACE_UNSUPPORTED "workspace uses a linked worktree (.git is a file), which is not supported yet" "$EX_WORKSPACE_UNSUPPORTED" ;;
    *) refuse REFUSED_WORKSPACE_UNSUPPORTED "workspace is not a Git repository" "$EX_WORKSPACE_UNSUPPORTED" ;;
  esac

}

issuer_check_eligibility() {
  local projects="$ISSUER_PROJECTS" canonical="$ISSUER_CANONICAL"
  # --- enrollment lookup -----------------------------------------------------
  # The binding is authority-side. A clone with identical content at another
  # path resolves to another canonical path and therefore has no enrollment.
  local matches count project_id record file
  matches=$(authority_find_projects "$canonical")
  count=$(printf '%s\n' "$matches" | grep -c . || true)
  if [ "$count" -eq 0 ]; then
    refuse REFUSED_NOT_ENROLLED "no enrollment is bound to $canonical" "$EX_NOT_ENROLLED"
  fi
  if [ "$count" -gt 1 ]; then
    refuse REFUSED_AMBIGUOUS_ENROLLMENT "$count enrollments are bound to $canonical" "$EX_AMBIGUOUS_ENROLLMENT"
  fi
  project_id=$(printf '%s\n' "$matches" | head -1)
  case "$project_id" in */*|..|.|"") refuse REFUSED_ENROLLMENT_CORRUPT "enrollment has an invalid project id" "$EX_ENROLLMENT_CORRUPT" ;; esac
  ISSUER_PROJECT_ID="$project_id"
  RESPONSE_PROJECT_ID=$(json_string "$project_id")

  file="$projects/$project_id/enrollment.json"
  if path_has_symlink "$file"; then
    refuse REFUSED_ENROLLMENT_CORRUPT "enrollment path traverses a symlink" "$EX_ENROLLMENT_CORRUPT"
  fi
  record=$(cat "$file" 2>/dev/null) || \
    refuse REFUSED_ENROLLMENT_CORRUPT "enrollment record is unreadable" "$EX_ENROLLMENT_CORRUPT"
  if ! printf '%s' "$record" | jq -e '
    type == "object" and (.schema | type) == "number" and
    (.project_id | type) == "string" and (.workspace | type) == "string" and
    (.execution.user | type) == "string" and (.execution.uid | type) == "number" and
    (.approved_contract | type) == "object" and
    (.approved_contract_fingerprint | type) == "string" and
    (.approved_mechanism | type) == "array" and
    (.approved_environment | type) == "array" and
    (.path_eligibility | type) == "array" and
    (.status | type) == "string"
  ' >/dev/null 2>&1; then
    refuse REFUSED_ENROLLMENT_CORRUPT "enrollment record does not match the authority schema" "$EX_ENROLLMENT_CORRUPT"
  fi
  if [ "$(printf '%s' "$record" | jq -r '.schema')" != "$AUTHORITY_SCHEMA" ]; then
    refuse REFUSED_ENROLLMENT_CORRUPT "enrollment uses schema $(printf '%s' "$record" | jq -r '.schema'); re-enroll with this authority version" "$EX_ENROLLMENT_CORRUPT"
  fi
  if [ "$(printf '%s' "$record" | jq -r '.workspace')" != "$canonical" ]; then
    refuse REFUSED_ENROLLMENT_CORRUPT "enrollment workspace does not match its own binding" "$EX_ENROLLMENT_CORRUPT"
  fi
  if [ "$(printf '%s' "$record" | jq -r '.status')" != eligible ]; then
    refuse REFUSED_ENROLLMENT_INELIGIBLE "enrollment was approved as ineligible: $(printf '%s' "$record" | jq -r '.reasons | join("; ")')" "$EX_ENROLLMENT_INELIGIBLE"
  fi

  ISSUER_RECORD="$record"
  # A caller who is not the enrolled developer is turned away here, before the
  # authority spends any work on their behalf and before any later refusal can
  # mask the real reason.
  issuer_caller_gate

  # --- contract revalidation -------------------------------------------------
  local current_contract current_fp approved_fp contract_err contract_reason
  contract_err=$(mktemp "${TMPDIR:-/tmp}/agent-md-contract-err.XXXXXX") \
    || respond refused REFUSED_CONTRACT_CHANGED "cannot create a temporary file" "$EX_INTERNAL"
  if ! current_contract=$(authority_read_contract "$canonical/agent-md.toml" 2>"$contract_err"); then
    contract_reason=$(cat "$contract_err"); rm -f "$contract_err"
    RESPONSE_CONTRACT='"unreadable"'
    refuse REFUSED_CONTRACT_CHANGED "current verification contract is unusable: ${contract_reason:-unknown}" "$EX_CONTRACT_CHANGED"
  fi
  rm -f "$contract_err"
  current_fp=$(printf '%s' "$current_contract" | jq -cS . | sha256_hex) || \
    respond refused REFUSED_CONTRACT_CHANGED "cannot fingerprint the current contract" "$EX_INTERNAL"
  approved_fp=$(printf '%s' "$record" | jq -r '.approved_contract_fingerprint')
  if [ "$current_fp" != "$approved_fp" ]; then
    RESPONSE_CONTRACT='"changed"'
    refuse REFUSED_CONTRACT_CHANGED "the verification contract changed since approval; re-approve it" "$EX_CONTRACT_CHANGED"
  fi
  RESPONSE_CONTRACT='"current"'

  # --- mechanism revalidation ------------------------------------------------
  # Compared against the authority-side approved identities, never against HEAD:
  # HEAD lives inside the repository the executor controls.
  local path digest approved
  while IFS= read -r approved; do
    [ -n "$approved" ] || continue
    path=$(printf '%s' "$approved" | jq -r '.path')
    case "$path" in /*|*..*) RESPONSE_MECHANISM='"unsupported"'; refuse REFUSED_MECHANISM_CHANGED "approved mechanism path is unsafe: $path" "$EX_MECHANISM_CHANGED" ;; esac
    if [ -L "$canonical/$path" ]; then
      RESPONSE_MECHANISM='"unsupported"'
      refuse REFUSED_MECHANISM_CHANGED "mechanism file is a symlink: $path" "$EX_MECHANISM_CHANGED"
    fi
    if [ ! -f "$canonical/$path" ]; then
      RESPONSE_MECHANISM='"missing"'
      refuse REFUSED_MECHANISM_CHANGED "mechanism file is missing: $path" "$EX_MECHANISM_CHANGED"
    fi
    digest=$(sha256_file "$canonical/$path") || {
      RESPONSE_MECHANISM='"unsupported"'
      refuse REFUSED_MECHANISM_CHANGED "mechanism file cannot be hashed: $path" "$EX_MECHANISM_CHANGED"
    }
    if [ "$digest" != "$(printf '%s' "$approved" | jq -r '.digest')" ]; then
      RESPONSE_MECHANISM='"changed"'
      refuse REFUSED_MECHANISM_CHANGED "mechanism file changed since approval: $path" "$EX_MECHANISM_CHANGED"
    fi
  done <<EOF
$(printf '%s' "$record" | jq -c '.approved_mechanism[]')
EOF
  RESPONSE_MECHANISM='"current"'

  # --- environment revalidation ----------------------------------------------
  local exec_user exec_uid gids approved_path name
  exec_user=$(printf '%s' "$record" | jq -r '.execution.user')
  exec_uid=$(printf '%s' "$record" | jq -r '.execution.uid')
  gids=$(gids_of_user "$exec_user" 2>/dev/null) || {
    RESPONSE_ENVIRONMENT='"unresolvable"'
    refuse REFUSED_ENV_CHANGED "execution user $exec_user no longer resolves" "$EX_ENV_CHANGED"
  }

  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if env_name_is_forbidden "$name"; then
      RESPONSE_ENVIRONMENT='"forbidden"'
      refuse REFUSED_ENV_CHANGED "approved environment contains a variable this authority would refuse today: $name" "$EX_ENV_CHANGED"
    fi
  done <<EOF
$(printf '%s' "$record" | jq -r '.approved_environment[].name')
EOF

  approved_path=$(printf '%s' "$record" | jq -r '.approved_environment[] | select(.name == "PATH") | .value')
  if [ -z "$approved_path" ]; then
    RESPONSE_ENVIRONMENT='"incomplete"'
    refuse REFUSED_ENV_CHANGED "approved environment declares no PATH" "$EX_ENV_CHANGED"
  fi

  local report ineligible
  report=$(build_path_report "$approved_path" "$exec_uid" "$gids")
  ineligible=$(printf '%s' "$report" | jq -r '[.[] | select(.status != "eligible") | "\(.entry): \(.reason)"] | join("; ")')
  if [ -n "$ineligible" ]; then
    RESPONSE_ENVIRONMENT='"changed"'
    refuse REFUSED_ENV_CHANGED "approved PATH is no longer trustworthy: $ineligible" "$EX_ENV_CHANGED"
  fi

  # The approved PATH must still resolve to the same directories it did at
  # approval time, so a replaced symlink cannot silently redirect a tool.
  local drift
  drift=$(jq -rn --argjson approved "$(printf '%s' "$record" | jq -c '.path_eligibility')" \
    --argjson current "$report" '
      ([$approved[] | {key: .entry, value: .resolved}] | from_entries) as $was
      | [$current[] | select(($was[.entry] // null) != .resolved) | .entry] | join(", ")')
  if [ -n "$drift" ]; then
    RESPONSE_ENVIRONMENT='"changed"'
    refuse REFUSED_ENV_CHANGED "approved PATH entries now resolve elsewhere: $drift" "$EX_ENV_CHANGED"
  fi
  RESPONSE_ENVIRONMENT='"current"'
  ISSUER_RECORD="$record"

  ISSUER_RECORD="$record"
}

# --- evaluate ----------------------------------------------------------------
#
# Runs the approved contract against one sealed snapshot and reports what
# happened. It produces no signature, no sequence number and no receipt: the
# result is structured output of this orchestration and nothing more, which is
# why its vocabulary is candidate_pass and candidate_fail.

# The caller's identity comes from the boundary that was actually crossed, not
# from anything the caller said. sudo sets SUDO_UID after resetting the
# environment, so a caller cannot supply it; and reaching this subcommand at
# all requires already running as the authority account, which the developer
# has no way to become except through the one rule that leads here.
issuer_bind_caller() {
  if is_real_root_prefix; then
    [ "$(id -un)" = "$AUTHORITY_SERVICE_USER" ] || \
      refuse REFUSED_CALLER_UNBOUND "evaluate runs as $(id -un); it must be reached as $AUTHORITY_SERVICE_USER through the authority boundary" "$EX_CALLER_UNBOUND"
    if [ -z "${SUDO_UID:-}" ] || [ -z "${SUDO_USER:-}" ]; then
      refuse REFUSED_CALLER_UNBOUND "no caller identity was supplied by the boundary; direct invocation is not accepted" "$EX_CALLER_UNBOUND"
    fi
  fi
  ISSUER_CALLER_UID=${SUDO_UID:-$(id -u)}
  ISSUER_CALLER_USER=${SUDO_USER:-$(id -un)}
  case "$ISSUER_CALLER_UID" in ''|*[!0-9]*) refuse REFUSED_CALLER_UNBOUND "caller identity is malformed" "$EX_CALLER_UNBOUND" ;; esac
  RESPONSE_CALLER=$(jq -nc --arg u "$ISSUER_CALLER_USER" --argjson i "$ISSUER_CALLER_UID" '{user:$u,uid:$i}')
}

# The enrolled developer is authority-side state. Nothing in the repository can
# turn one developer into another.
# A no-op for a plain eligibility question, which asks about a project rather
# than on behalf of a caller.
issuer_caller_gate() {
  [ "$RESPONSE_MODE" = evaluation ] || return 0
  issuer_assert_caller_matches_enrollment
}

issuer_assert_caller_matches_enrollment() {
  local enrolled_uid enrolled_user
  enrolled_uid=$(printf '%s' "$ISSUER_RECORD" | jq -r '.execution.uid')
  enrolled_user=$(printf '%s' "$ISSUER_RECORD" | jq -r '.execution.user')
  [ "$enrolled_uid" = "$ISSUER_CALLER_UID" ] || \
    refuse REFUSED_CALLER_MISMATCH "this project is enrolled for $enrolled_user (uid $enrolled_uid); the caller is $ISSUER_CALLER_USER (uid $ISSUER_CALLER_UID)" "$EX_CALLER_MISMATCH"
}

# --- Evaluation transaction --------------------------------------------------
#
# The lock covers the whole terminal evaluation: final eligibility, the
# reservation, the snapshot, the checks, the revalidation and the terminal
# transition. Anything less and two evaluations could interleave around the
# sequence or around the single current-run pointer.
#
# It is taken per project, not per (project, scope), even though the sequence
# lines are per scope. The runs directory, the current-run pointer a check
# resolves through, and the state file are all per project today, so two
# concurrent evaluations in different scopes would race over the pointer and
# lose one of the two state updates. Serialising the project is the safe
# reading of that layout; splitting the lock would need those resources split
# first.
#
# Non-blocking on purpose. A second evaluation is told that one is already
# running rather than queueing behind it: it reserves nothing, writes nothing
# and cannot be mistaken for the first one's result.
issuer_acquire_evaluation_lock() {
  local lock dir
  dir="$(projects_dir)/$ISSUER_PROJECT_ID"
  lock=$(authority_evaluation_lock "$ISSUER_PROJECT_ID")
  if [ ! -e "$lock" ]; then
    chmod u+w "$dir" 2>/dev/null || true
    : > "$lock" 2>/dev/null || refuse REFUSED_STATE_UNUSABLE \
      "the authority cannot create its evaluation lock" "$EX_STATE_UNUSABLE"
    chmod 0600 "$lock" 2>/dev/null || true
  fi
  [ -L "$lock" ] && refuse REFUSED_STATE_UNUSABLE "the evaluation lock is a symlink" "$EX_STATE_UNUSABLE"
  exec 8>"$lock" || refuse REFUSED_STATE_UNUSABLE \
    "the authority cannot open its evaluation lock" "$EX_STATE_UNUSABLE"
  flock -n 8 || refuse REFUSED_EVALUATION_IN_PROGRESS \
    "another evaluation already holds this project; this request reserved nothing" \
    "$EX_EVALUATION_IN_PROGRESS"
}

# Durable before the first check runs. If this ordering were reversed, a crash
# between "the checks failed" and "record that they failed" would leave the
# previous pass looking current.
issuer_reserve_sequence() {
  local out
  if ! out=$(authority_state_reserve "$ISSUER_PROJECT_ID" "$ISSUER_SCOPE" "$ISSUER_RUN_ID"); then
    refuse REFUSED_STATE_UNUSABLE "the authority state is not usable: $out" "$EX_STATE_UNUSABLE"
  fi
  ISSUER_SEQUENCE=${out%% *}
  ISSUER_RECOVERED=${out##* }
  RESPONSE_SEQUENCE="$ISSUER_SEQUENCE"
}

# The safety net for every ordinary exit taken after a reservation: a refusal, a
# die, an exhausted budget. It is the controlled-incomplete path, so it burns
# the sequence and leaves the previous terminal alone.
#
# A killed process never reaches it, which is the intended difference: its
# pending survives and keeps the previous terminal suppressed.
issuer_on_exit() {
  [ -n "$ISSUER_SEQUENCE" ] || return 0
  [ "$ISSUER_TERMINAL_DONE" -eq 0 ] || return 0
  local reason
  if ! reason=$(authority_state_release_pending "$ISSUER_PROJECT_ID" "$ISSUER_SCOPE" "$ISSUER_RUN_ID"); then
    printf '%s: the incomplete evaluation could not be closed: %s\n' "$PROGRAM" "$reason" >&2
  fi
}

# Recomputed live and compared with what the run was captured against. A
# divergence here means the checks did run, and ran against a tree that no
# longer describes the workspace, so their result may not be published -- but it
# still supersedes whatever came before, because leaving the older result
# current would be a lie in the other direction.
issuer_identity_still_matches() {
  local fingerprints
  fingerprints=$("$AUTHORITY_SELF_DIR/agent-md-authority" identity-fingerprints \
                   "$ISSUER_PROJECT_ID" ${ROOT:+--root "$ROOT"} 2>/dev/null 8>&-) || return 1
  jq -e . >/dev/null 2>&1 <<<"$fingerprints" || return 1
  [ "$(jq -cS . <<<"$fingerprints")" = "$(jq -cS . <<<"$RESPONSE_IDENTITY")" ]
}

issuer_commit_terminal() {
  local status="$1" out
  if ! out=$(authority_state_commit_terminal "$ISSUER_PROJECT_ID" "$ISSUER_SCOPE" \
               "$status" "$ISSUER_RUN_ID" "$RESPONSE_IDENTITY"); then
    refuse REFUSED_STATE_UNUSABLE "the terminal result could not be recorded: $out" "$EX_STATE_UNUSABLE"
  fi
  ISSUER_TERMINAL_DONE=1
}

issuer_prepare_run() {
  local out
  if ! out=$("$AUTHORITY_SELF_DIR/agent-md-authority" prepare-run "$ISSUER_PROJECT_ID" \
               --run-id "$ISSUER_RUN_ID" ${ROOT:+--root "$ROOT"} 2>&1 8>&-); then
    refuse REFUSED_RUN_FAILED "the evaluation run could not be prepared: $(printf '%s' "$out" | tail -1)" "$EX_RUN_FAILED"
  fi

  local run_dir manifest_file identity_file
  run_dir=$(authority_run_dir "$ISSUER_PROJECT_ID" "$ISSUER_RUN_ID")
  manifest_file="$run_dir/snapshot/manifest.json"
  identity_file="$run_dir/identity.json"
  [ -f "$manifest_file" ] || refuse REFUSED_RUN_FAILED "the prepared run has no snapshot manifest" "$EX_RUN_FAILED"
  [ -f "$identity_file" ] || refuse REFUSED_RUN_FAILED "the prepared run has no bound identity" "$EX_RUN_FAILED"
  if ! jq -e '
    (.fingerprints | type) == "object" and
    ([.fingerprints.source, .fingerprints.contract, .fingerprints.control, .fingerprints.mechanism]
      | all(.[]; type == "object" and (.value | type == "string" and length == 64)))
  ' "$identity_file" >/dev/null 2>&1; then
    refuse REFUSED_RUN_FAILED "the prepared run has an incomplete bound identity" "$EX_RUN_FAILED"
  fi
  ISSUER_SNAPSHOT_FP=$(jq -cS . "$manifest_file" | sha256_hex)
  RESPONSE_SNAPSHOT=$(jq -nc --arg v "$ISSUER_SNAPSHOT_FP" '{algorithm:"sha256",value:$v}')
  ISSUER_SOURCE_FP=$(jq -r '.fingerprints.source.value' "$identity_file")
  RESPONSE_IDENTITY=$(jq -c '.fingerprints' "$identity_file")
}

# One hop per check, always through the descending boundary in production. The
# check's own output is untrusted and is kept away from stdout, which carries
# exactly one response object.
issuer_run_one_check() {
  local check="$1"
  # 8>&- keeps the evaluation lock out of the child. Without it a check that
  # outlives a killed issuer would still hold the lock through the inherited
  # descriptor, and no later evaluation could ever recover the pending. sudo
  # closes descriptors above 2 on its own; the direct path does not.
  if is_real_root_prefix; then
    sudo -n -u "$AUTHORITY_RUNNER_USER" "$(lib_dir)/run-check" "$ISSUER_PROJECT_ID" "$check" >&2 8>&-
  else
    "$AUTHORITY_SELF_DIR/run-check" "$ISSUER_PROJECT_ID" "$check" --root "$ROOT" >&2 8>&-
  fi
}

issuer_execute_checks() {
  local run_dir jobs_dir per_check total declared stages
  run_dir=$(authority_run_dir "$ISSUER_PROJECT_ID" "$ISSUER_RUN_ID")
  jobs_dir="$run_dir/jobs"

  local ordered=() name
  for name in $AUTHORITY_CHECK_ORDER; do
    [ -f "$jobs_dir/$name.json" ] && ordered+=("$name")
  done
  [ "${#ordered[@]}" -gt 0 ] || refuse REFUSED_RUN_FAILED "the prepared run carries no job" "$EX_RUN_FAILED"

  per_check=$(printf '%s' "$ISSUER_RECORD" | jq -r '.approved_contract.timeout_seconds')
  declared=$(printf '%s' "$ISSUER_RECORD" | jq -r '.approved_contract.total_timeout_seconds // empty')
  stages=${#ordered[@]}
  total=$(authority_derive_total_timeout "$per_check" "$stages" "$declared")

  # Every applicable check runs while the budget allows, which is what the core
  # does: a failing check does not hide the diagnosis of the ones after it.
  local started elapsed remaining status exhausted=false required command identity job
  started=$SECONDS
  for name in "${ordered[@]}"; do
    job="$jobs_dir/$name.json"
    command=$(jq -r '.command' "$job")
    identity=$(printf '%s' "$command" | sha256_hex)
    required=$(printf '%s' "$ISSUER_RECORD" | jq -r --arg n "$name" \
      'if (.approved_contract.required | index($n)) then "required" else "optional" end')
    elapsed=$(( SECONDS - started ))
    remaining=$(( total - elapsed ))
    if [ "$remaining" -le 0 ]; then
      exhausted=true
      RESPONSE_CHECKS=$(printf '%s' "$RESPONSE_CHECKS" | jq -c \
        --arg n "$name" --arg r "$required" --arg i "$identity" \
        '. + [{name:$n,requirement:$r,origin:"configured",command_identity:$i,exit_code:null,execution:"not_run"}]')
      continue
    fi
    if issuer_run_one_check "$name"; then status=0; else status=$?; fi
    RESPONSE_CHECKS=$(printf '%s' "$RESPONSE_CHECKS" | jq -c \
      --arg n "$name" --arg r "$required" --arg i "$identity" --argjson e "$status" \
      '. + [{name:$n,requirement:$r,origin:"configured",command_identity:$i,exit_code:$e,execution:"completed"}]')
  done
  elapsed=$(( SECONDS - started ))
  [ "$elapsed" -lt "$total" ] || exhausted=true
  RESPONSE_BUDGET=$(jq -nc --argjson p "$per_check" --argjson t "$total" \
    --argjson e "$elapsed" --argjson x "$exhausted" \
    '{per_check_seconds:$p,total_seconds:$t,elapsed_seconds:$e,exhausted:$x}')
  ISSUER_EXHAUSTED="$exhausted"
}

# Required checks decide the outcome; an optional failure is reported without
# blocking, which is the core's semantics. Any non-zero required check, any
# check that could not run, and an exhausted budget all make a candidate pass
# impossible.
issuer_conclude() {
  local missing failed
  failed=$(printf '%s' "$RESPONSE_CHECKS" | jq '[.[] | select(.requirement == "required" and (.exit_code != 0 or .execution != "completed"))] | length')
  missing=$(printf '%s' "$RESPONSE_CHECKS" | jq '[.[] | select(.execution != "completed")] | length')

  # An incomplete evaluation is not a verdict. The reserved sequence is burned
  # by the exit path and the previous terminal result stays current, because
  # nothing here observed the contract either passing or failing.
  if [ "$ISSUER_EXHAUSTED" = true ] || [ "$missing" -gt 0 ]; then
    respond refused REFUSED_BUDGET_EXHAUSTED "the evaluation did not complete within the approved budget" "$EX_BUDGET_EXHAUSTED"
  fi

  # The checks completed, so this evaluation owes a terminal result whichever
  # way it goes. Revalidation decides which one.
  if ! issuer_identity_still_matches; then
    issuer_commit_terminal identity_changed
    respond identity_changed IDENTITY_CHANGED \
      "the checks completed but the workspace identity changed before the result could be concluded; this attempt supersedes the previous result and publishes nothing" \
      "$EX_CANDIDATE_FAIL"
  fi
  if [ "$failed" -gt 0 ]; then
    issuer_commit_terminal candidate_fail
    respond candidate_fail CANDIDATE_FAIL "a required check did not return zero" "$EX_CANDIDATE_FAIL"
  fi
  issuer_commit_terminal candidate_pass
  respond candidate_pass CANDIDATE_PASS "every required check returned zero for this snapshot; this is orchestration output, not evidence" 0
}

cmd_evaluate() {
  RESPONSE_MODE=evaluation
  issuer_parse_options "$@"
  issuer_bind_caller
  issuer_resolve_request
  issuer_acquire_evaluation_lock
  issuer_check_eligibility

  # The run is named, then the sequence is reserved against that name and made
  # durable, and only then is anything captured or executed.
  ISSUER_RUN_ID=$(authority_new_id) || \
    refuse REFUSED_INTERNAL "no source of unique identifiers is available" "$EX_INTERNAL"
  authority_run_id_is_safe "$ISSUER_RUN_ID" || \
    refuse REFUSED_INTERNAL "the generated run identifier is malformed" "$EX_INTERNAL"
  RESPONSE_RUN_ID=$(json_string "$ISSUER_RUN_ID")
  trap issuer_on_exit EXIT
  issuer_reserve_sequence

  issuer_prepare_run
  issuer_execute_checks
  issuer_conclude
}

[ $# -gt 0 ] || { usage; exit "$EX_MALFORMED_REQUEST"; }
command -v jq >/dev/null 2>&1 || die "jq is required" "$EX_INTERNAL"
subcommand="$1"; shift
case "$subcommand" in
  eligibility) cmd_eligibility "$@" ;;
  evaluate) cmd_evaluate "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown subcommand: $subcommand" "$EX_MALFORMED_REQUEST" ;;
esac
